{
  "name": "@airdesign/ui",
  "version": "0.1.0",
  "description": "AirDesign UI pack: React components generated from the Lunagraph export",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./base.css": "./src/base.css"
  },
  "files": [
    "dist",
    "src",
    "COMPONENTS.md"
  ],
  "scripts": {
    "generate": "node ../scripts/build-ui-pack.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "docs": "npm run build && node ../scripts/build-ui-pack-docs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/pack.test.mjs"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19.3.1",
    "typescript": "^5"
  }
}
