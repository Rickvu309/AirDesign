---
import { signInCopy } from "../sign-in-copy";
import MailMark from "./check-email-art.astro";

const codeBoxes = [0, 1, 2, 3, 4, 5];
const mailButtonClass =
  "flex h-11 items-center justify-center gap-3 rounded-lg bg-background text-[length:var(--type-section)] font-medium shadow-[0_0_0_1px_var(--field-edge),0_1px_2px_var(--black-5)] pressable hover:brightness-[0.98]";
---

<div class="flex flex-col items-center rounded-2xl bg-background p-10 text-center shadow-[0px_0px_0px_1px_var(--black-7),0px_1px_2px_0px_var(--black-3),0px_12px_32px_0px_var(--black-4)] max-sm:p-6">
  <div class="my-px flex size-[var(--space-48)] items-center justify-center rounded-xl bg-[image:var(--fill-marketing)] text-white shadow-[inset_0_1px_0_var(--white-35),0_0_0_1px_var(--fill-marketing-bottom),0_1px_2px_var(--black-12)]">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
  </div>

  <p class="mt-[var(--space-24)] text-[length:var(--type-section)] leading-[1.5] text-muted-foreground">Sign-in link sent to</p>
  <p class="mt-1 text-[length:var(--type-section)] leading-[1.5] font-semibold break-all" data-pending-email></p>

  <p class="mt-[var(--space-24)] text-[length:var(--type-dense)] leading-[1.31] text-muted-foreground" id="six-digit-code-label">Or enter the 6-digit code</p>
  <div class="relative mt-2.5 grid h-12 w-full max-w-[304px] grid-cols-6 gap-2 rounded-lg" data-six-digit-code data-focus-ring>
    {codeBoxes.map(() => <div class="code-box" data-code-box aria-hidden="true"></div>)}
    <input
      class="absolute inset-0 size-full cursor-text opacity-0"
      name="code"
      inputmode="numeric"
      autocomplete="one-time-code"
      autocapitalize="none"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="done"
      aria-labelledby="six-digit-code-label"
      autofocus
    />
  </div>
  <p id="sign-in-code-error" class="reserved-line mt-2 text-[length:var(--type-dense)] leading-[1.31] text-danger-text" role="alert" data-code-error>
    <span data-failure hidden>{signInCopy.codeRefused}</span>
  </p>

  <div class="mt-3 grid w-full grid-cols-2 gap-2.5">
    <a class={mailButtonClass} href="https://outlook.live.com/mail/" target="_blank" rel="noreferrer">
      <MailMark name="outlook" />
      Open Outlook
    </a>
    <a class={mailButtonClass} href="https://mail.google.com/" target="_blank" rel="noreferrer">
      <MailMark name="gmail" />
      Open Gmail
    </a>
  </div>

  <p class="mt-[var(--space-24)] text-[length:var(--type-body)] leading-[1.43] text-muted-foreground">
    Didn't get it?{" "}
    <button class="touch-target pressable cursor-pointer px-1 font-semibold text-primary-strong disabled:cursor-default" type="button" data-send-again>{signInCopy.sendAgain}</button>
  </p>
  <p class="reserved-line mt-2 text-[length:var(--type-dense)] leading-[1.31] text-muted-foreground data-failed:text-danger-text" role="status" data-send-again-status></p>
</div>
