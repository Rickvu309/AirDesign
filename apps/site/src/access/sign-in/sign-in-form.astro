---
import { signInCopy } from "../sign-in-copy";
---

<form class="rounded-2xl bg-background p-10 shadow-[0px_0px_0px_1px_var(--black-7),0px_1px_2px_0px_var(--black-3),0px_12px_32px_0px_var(--black-4)] max-sm:p-6" method="post" novalidate data-sign-in-form>
  <label class="block text-[length:var(--type-body)] leading-[1.5] font-medium" for="sign-in-email">Email</label>
  <input
    id="sign-in-email"
    class="sign-in-email mt-2 block h-11 w-full rounded-lg bg-background px-3.5 leading-[1.5] text-[length:var(--type-section)] placeholder:text-faint-foreground"
    name="email"
    type="email"
    placeholder="Your email address"
    autocomplete="email"
    inputmode="email"
    autocapitalize="none"
    autocorrect="off"
    spellcheck="false"
    enterkeyhint="go"
    required
  />
  <p id="sign-in-error" class="reserved-line mt-1.5 text-[length:var(--type-dense)] leading-[1.31] text-danger-text" role="alert" data-sign-in-error>
    <span data-failure hidden>{signInCopy.emailFailed}</span>
  </p>
  <button class="primary-button mt-3 h-11 w-full cursor-pointer rounded-lg text-[length:var(--type-section)]" type="submit">Continue with email</button>
  <p class="mt-5 text-center text-[length:var(--type-dense)] leading-[1.31] text-muted-foreground">New email? The same link creates your account.</p>
</form>

<script>
  import { readPendingEmail, rememberNextFromSearch } from "../pending-sign-in-email";
  import { signInCopy } from "../sign-in-copy";
  import { clearSignInFailure, showSignInFailure } from "../sign-in-failure";
  import { startEmailSignIn } from "../sign-in-requests";

  rememberNextFromSearch(location.search);

  const form = document.querySelector<HTMLFormElement>("[data-sign-in-form]");
  const emailInput = form?.querySelector<HTMLInputElement>("input[name=email]");
  const failure = form?.querySelector<HTMLElement>("[data-sign-in-error]");
  const pendingEmail = readPendingEmail();
  if (emailInput && pendingEmail !== null && emailInput.value === "") emailInput.value = pendingEmail;

  emailInput?.addEventListener("input", () => {
    if (failure && emailInput) clearSignInFailure(failure, emailInput);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = new FormData(event.currentTarget as HTMLFormElement).get("email");
    if (typeof email !== "string" || !emailInput || !failure) {
      return;
    }
    clearSignInFailure(failure, emailInput);
    await startEmailSignIn("", email, (path) => location.assign(path), (why) => {
      showSignInFailure(failure, emailInput, why === "refused" ? signInCopy.emailRefused : signInCopy.emailFailed);
    });
  });
</script>
