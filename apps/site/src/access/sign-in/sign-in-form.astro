<form class="rounded-2xl bg-background p-10 shadow-[0px_0px_0px_1px_#00000012,0px_1px_2px_0px_#00000008,0px_12px_32px_0px_#0000000a] max-sm:p-6" method="post" data-sign-in-form>
  <label class="block text-[14px] leading-[1.5] font-medium" for="sign-in-email">Email</label>
  <input
    id="sign-in-email"
    class="sign-in-email mt-2 block h-11 w-full rounded-lg bg-background px-3.5 text-[15px] leading-[1.5] placeholder:text-faint-foreground"
    name="email"
    type="email"
    placeholder="Your email address"
    autocomplete="email"
    required
  />
  <button class="primary-button mt-5 h-11 w-full cursor-pointer rounded-lg text-[15px] shadow-[inset_0_0_0_1px_#2d6fcd,0px_1px_0px_0px_#ffffff59,0px_1px_2px_0px_#0000001f]" type="submit">Continue with email</button>
  <p class="mt-5 text-center text-[13px] leading-[1.31] text-muted-foreground">New email? The same link creates your account.</p>
</form>

<script>
  import { rememberPendingEmail } from "../pending-sign-in-email";

  document.querySelector<HTMLFormElement>("[data-sign-in-form]")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const email = new FormData(event.currentTarget as HTMLFormElement).get("email");
    if (typeof email === "string") {
      rememberPendingEmail(email);
      location.assign("/sign-in/check");
    }
  });
</script>
