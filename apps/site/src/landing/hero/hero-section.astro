---
import CheckIcon from "../../site/check-icon.astro";
import HeroFinanceChart from "./hero-finance-chart-art.astro";

const ticks = [
  { label: "ACTION TITLES", value: "8/8", direction: "up" },
  { label: "MECE", value: "Pass", direction: "up" },
  { label: "SO WHAT", value: "Clear", direction: "up" },
  { label: "GHOST DECK", value: "Final", direction: "up" },
  { label: "SLIDES", value: "80 to 8", direction: "down" },
  { label: "FOOTNOTES SOURCED", value: "100%", direction: "up" },
  { label: "EBITDA BRIDGE", value: "Tied out", direction: "up" },
  { label: "COMPS", value: "Refreshed", direction: "up" },
  { label: "TURN TIME", value: "2h", direction: "down" },
  { label: "PAGE FLIP", value: "Done", direction: "up" },
  { label: "BOARD ASK", value: "Approve", direction: "up" },
] as const;

const tickerCopies = [0, 1, 2];
const quarters = ["Q3 24", "Q4 24", "Q1 25", "Q2 25", "Q3 25"];
---

<section class="hero-landing relative bg-background">
  <div class="hero-stage relative h-[720px] overflow-clip lg:h-[900px]">
  <div class="absolute inset-0 *:size-full">
    <HeroFinanceChart />
  </div>
  <svg class="hero-chart-annotation absolute inset-0 size-full max-lg:hidden" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
    <line x1="1182" y1="461.5" x2="1182" y2="324" stroke="var(--primary-strong)" stroke-width="1" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  </svg>
  <div class="absolute inset-x-0 top-[128px] lg:top-[236px]">
    <div class="page-column">
      <h1 class="font-serif text-[clamp(2.25rem,11vw,6.5rem)] leading-none font-normal tracking-[-0.0327em] whitespace-nowrap lg:text-[clamp(4.5rem,7.22vw,6.5rem)]">Clarity is the edge.</h1>
      <p class="pt-5 text-[clamp(1.125rem,2vw,1.5rem)] leading-[1.3] tracking-[-0.4px] text-muted-foreground">So clear the CEO puts the phone down.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-9">
        <a href="/sign-in" class="primary-button h-[var(--space-48)] rounded-full px-5 text-[length:var(--type-section)] whitespace-nowrap">Start free</a>
        <a href="/sign-in" class="touch-target pressable justify-start gap-1.5 text-[length:var(--type-section)] font-medium whitespace-nowrap">
          Import a PowerPoint
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-chart-annotation hero-chart-pill status-pill absolute top-[272px] left-[calc(1182/1440*100%-129px)] max-lg:hidden">
    <span class="status-pill-check"><CheckIcon size={18} /></span>
    Zero follow-up questions.
  </div>
  <div class="hero-chart-annotation absolute top-[470.5px] left-[calc(1182/1440*100%-5px)] size-2.5 rounded-full bg-primary-strong max-lg:hidden"></div>
  <div class="hero-chart-annotation hero-chart-ring absolute top-[464.5px] left-[calc(1182/1440*100%-11px)] size-[var(--space-24)] rounded-full opacity-35 shadow-[0_0_0_0.5px_var(--primary-strong),inset_0_0_0_0.5px_var(--primary-strong)] max-lg:hidden"></div>

  </div>
  <div class="hero-ticker absolute inset-x-0 bottom-0">
    <div class="pb-1.5">
      <div class="page-column flex justify-between font-mono text-[length:var(--type-caption)] tracking-[0.6px] text-quiet">
        {quarters.map((quarter) => <span>{quarter}</span>)}
      </div>
    </div>
    <div class="ticker-bar relative flex h-11 items-center overflow-clip border-t border-transparent pt-1 before:absolute before:inset-x-0 before:bottom-0 before:h-10 before:border-t before:border-[var(--steel)] before:bg-background">
      <div class="ticker-mark relative z-10 flex h-full shrink-0 items-center bg-navy pr-6 pl-[max(1.5rem,env(safe-area-inset-left,0px))] text-[length:var(--type-caption)] font-semibold tracking-[1px] whitespace-nowrap text-primary-foreground">GOOD DECK</div>
      <div class="ticker-track relative flex h-full shrink-0">
        {tickerCopies.map((copy) => (
          <div class="ticker-copy flex h-full shrink-0 items-center" aria-hidden={copy === 0 ? undefined : "true"}>
            {ticks.map((tick) => (
              <div class="ticker-item flex h-full shrink-0 items-center gap-2.5 border-r border-[var(--parchment)] px-6">
                <span class="font-mono text-[length:var(--type-caption)] tracking-[0.6px] whitespace-nowrap text-quiet">{tick.label}</span>
                <span class="text-[length:var(--type-dense)] font-medium whitespace-nowrap">{tick.value}</span>
                <span class:list={["text-[9px]", tick.direction === "up" ? "text-positive-text" : "text-negative"]}>{tick.direction === "up" ? "▲" : "▼"}</span>
              </div>
            ))}
          </div>
        ))}
      </div>
      <button type="button" class="ticker-pause touch-target pressable absolute right-0 bottom-0 z-10 pt-1 text-muted-foreground before:absolute before:inset-x-0 before:bottom-0 before:h-10 before:border-t before:border-[var(--steel)] before:bg-background" aria-pressed="false" aria-label="Pause the ticker" data-ticker-pause>
        <svg class="relative" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path class="ticker-pause-bars" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path>
          <path class="ticker-pause-play" d="M8 5.5v13l11-6.5z"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-ticker-pause]").forEach((button) => {
    const track = button.parentElement?.querySelector<HTMLElement>(".ticker-track");
    button.addEventListener("click", () => {
      const paused = track?.toggleAttribute("data-paused") ?? false;
      button.setAttribute("aria-pressed", String(paused));
    });
  });
</script>
