---
import AirdesignMark from "../../brand/airdesign-mark.astro";

const links = [
  { label: "Pricing", href: "#pricing" },
  { label: "Agent guides", href: "/agents" },
  { label: "Sign in", href: "/sign-in" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
];
---

<footer class="border-t border-border bg-background">
  <div class="page-column flex flex-col gap-5 py-10 md:h-[119px] md:flex-row md:items-center md:justify-between md:py-0">
    <div class="flex items-center gap-2.5">
      <AirdesignMark size={20} />
      <span class="text-[14px] font-semibold">AirDesign</span>
      <span class="text-[14px] text-faint-foreground">Clarity is the edge.</span>
    </div>
    <nav class="flex flex-wrap items-center gap-x-7 gap-y-2" aria-label="Footer">
      {links.map((link) => <a href={link.href} class="text-link text-[13px] text-muted-foreground">{link.label}</a>)}
    </nav>
  </div>
</footer>
