---
import CheckIcon from "../../site/check-icon.astro";

const features = [
  "Unlimited decks",
  "Built-in agent",
  "Bring Claude or Codex",
  "PDF export",
  "Usage resets every week",
];
---

<section id="pricing" class="scroll-mt-6 border-t border-border bg-background py-[72px] lg:pt-[120px] lg:pb-[91px]">
  <div class="page-column flex flex-col items-center text-center">
    <h2 class="section-title">AirDesign is free.</h2>
    <p class="section-lead">Every feature, every week. No plan, no trial.</p>

    <div class="mt-10 flex w-full max-w-[440px] flex-col gap-6 rounded-3xl bg-background p-7 text-left shadow-[inset_0_0_0_1px_var(--sheet),0px_12px_40px_var(--black-5)] lg:mt-[81px]">
      <div class="flex items-end gap-2">
        <span class="text-[56px] leading-none font-semibold tracking-[-1.5px]">$0</span>
        <span class="pb-1.5 text-base text-quiet">forever</span>
      </div>
      <ul class="flex flex-col gap-3">
        {features.map((feature) => (
          <li class="flex items-center gap-2.5 text-[length:var(--type-section)]">
            <span class="text-primary"><CheckIcon size={15} /></span>
            {feature}
          </li>
        ))}
      </ul>
      <a href="/sign-in" class="primary-button h-11 rounded-[var(--shape-card)] text-[length:var(--type-section)]">Start free</a>
    </div>

    <p class="mt-8 lg:mt-[var(--space-32)] text-[length:var(--type-section)] text-quiet">Out of Aira for the week? Your own Claude or Codex keeps working.</p>
  </div>
</section>
