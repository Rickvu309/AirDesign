---
import CheckIcon from "../../site/check-icon.astro";
import editorDemoMarkup from "./editor-demo-art.html?raw";
---

<section id="product" class="scroll-mt-6 border-t border-border bg-background py-[72px] lg:pt-[112px] lg:pb-[111px]">
  <div class="page-column">
    <h2 class="section-title">Make slides like magic.</h2>
    <p class="section-lead">Tell Aira what you need. Watch the slides fill in.</p>

    <div class="relative mt-8 lg:mt-[73px]">
      <div class="status-pill mb-4 max-w-full max-sm:text-[length:var(--type-dense)] max-[359px]:h-auto max-[359px]:min-h-[var(--space-48)] max-[359px]:py-2 max-[359px]:whitespace-normal md:absolute md:top-[-44px] md:right-[10.5%] md:z-10 md:mb-0">
        <span class="status-pill-check"><CheckIcon size={18} /></span>
        Building slide 3 of 8. Coffee optional.
      </div>
      <div
        class="fit-frame picture overflow-clip rounded-3xl bg-background shadow-[0px_0px_0px_1px_var(--black-10),0px_30px_80px_var(--strong-15),0px_4px_12px_var(--navy-5)]"
        style="--frame-width: 1248; --frame-height: 784"
        data-fit-frame
        aria-hidden="true"
      >
        <div class="fit-frame-content" data-editor-demo set:html={editorDemoMarkup} />
      </div>
      <button
        type="button"
        class="touch-target pressable group absolute top-full right-0 mt-2 rounded-full"
        aria-label="Pause demo"
        aria-pressed="false"
        data-demo-pause
        hidden
      >
        <span class="flex size-8 items-center justify-center rounded-full bg-background text-muted-foreground shadow-[0px_0px_0px_1px_var(--black-10),0px_2px_6px_var(--navy-5)]">
          <svg class="group-aria-pressed:hidden" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M4 2.5h2.6a.6.6 0 0 1 .6.6v9.8a.6.6 0 0 1-.6.6H4a.6.6 0 0 1-.6-.6V3.1a.6.6 0 0 1 .6-.6Zm5.4 0H12a.6.6 0 0 1 .6.6v9.8a.6.6 0 0 1-.6.6H9.4a.6.6 0 0 1-.6-.6V3.1a.6.6 0 0 1 .6-.6Z"></path></svg>
          <svg class="hidden group-aria-pressed:block" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M5 2.8v10.4L13 8Z"></path></svg>
        </span>
      </button>
    </div>
  </div>
</section>

<script>
  import { playEditorDemoAnimation } from "./editor-demo-animation";

  document
    .querySelectorAll("[data-editor-demo]")
    .forEach((demo) =>
      playEditorDemoAnimation(demo, demo.closest("section")?.querySelector<HTMLButtonElement>("[data-demo-pause]") ?? null),
    );
</script>
