---
import { markBar, markColor, markSlash, markStem } from "./airdesign-mark-art";

interface Props {
  size: number;
}

const { size } = Astro.props;
---

<svg viewBox="0 0 64 64" width={size} height={size} class="shrink-0" aria-hidden="true">
  <path d="M13 57l19-50 19 50" fill="none" stroke={markColor} stroke-width={markStem} stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M6 44l52-14" fill="none" stroke={markSlash} stroke-width={markBar} stroke-linecap="round"></path>
</svg>
