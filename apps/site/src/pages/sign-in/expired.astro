---
import AirdesignMark from "../../site/airdesign-mark.astro";
import SiteDocument from "../../site/site-document.astro";
---

<SiteDocument title="This link has expired">
  <main class="flex min-h-dvh flex-col items-center justify-center px-4 py-8 text-center">
    <AirdesignMark size={44} />
    <h1 class="mt-[21px] text-[length:var(--type-section)] leading-[1.5] font-semibold">This link has expired</h1>
    <p class="mt-[var(--space-4)] text-[length:var(--type-dense)] leading-[1.31] text-faint-foreground">Sign-in links work once and last 15 minutes.</p>
    <a class="primary-button mt-5 h-[38px] w-[140px] rounded-lg text-[length:var(--type-section)] shadow-[inset_0_0_0_1px_var(--primary-strong),0px_1px_0px_0px_var(--white-35),0px_1px_2px_0px_var(--black-12)]" href="/sign-in">Send a new link</a>
  </main>
</SiteDocument>
