---
import SignInForm from "../access/sign-in/sign-in-form.astro";
import AirdesignMark from "../site/airdesign-mark.astro";
import SiteDocument from "../site/site-document.astro";
---

<SiteDocument title="Sign in or create an account" top="canvas">
  <div class="flex min-h-dvh flex-col edge-inline bg-canvas">
    <main class="mx-auto w-full max-w-[440px] pt-[clamp(48px,14.3svh,132px)]">
      <div class="flex flex-col items-center">
        <AirdesignMark size={40} />
        <h1 class="mt-5 text-center text-[26px] leading-[1.2] font-semibold tracking-[-0.5px]">Sign in or create an account</h1>
      </div>
      <div class="mt-7">
        <SignInForm />
      </div>
    </main>
    <footer class="mt-auto flex flex-wrap justify-center pt-8 pb-[max(1rem,env(safe-area-inset-bottom,0px))] text-[length:var(--type-body)] leading-[1.43] text-muted-foreground">
      <a class="text-link touch-target px-1 underline underline-offset-2" href="/terms">Terms of Service</a>
      <span class="self-center">and</span>
      <a class="text-link touch-target px-1 underline underline-offset-2" href="/privacy">Privacy Policy</a>
    </footer>
  </div>
</SiteDocument>
