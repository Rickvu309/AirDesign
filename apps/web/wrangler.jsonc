{
  "name": "airdesign-web",
  "main": "worker/api-forward.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "routes": [{ "pattern": "studio.airdesign.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/sign-in/*",
      "/sign-out",
      "/account/delete",
      "/account/agents",
      "/account/agents/revoke",
      "/decks/*",
      "/oauth/client",
      "/oauth/approve",
      "/oauth/register",
      "/oauth/token",
      "/oauth/revoke",
      "/mcp",
      "/aira/*",
      "/.well-known/*",
    ],
  },
}
