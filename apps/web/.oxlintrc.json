{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/forbid-dom-props": [
      "error",
      {
        "forbid": [
          {
            "propName": "onPointerLeave",
            "message": "React fires its leave only after a pointerout, and the browser sends none when the node under the pointer was removed. Listen for the native pointerleave with addEventListener, as apps/web/src/editor/use-canvas-pointer.ts does. There is no opt-out."
          },
          {
            "propName": "onMouseLeave",
            "message": "React fires its leave only after a mouseout, and the browser sends none when the node under the pointer was removed. Listen for the native pointerleave with addEventListener, as apps/web/src/editor/use-canvas-pointer.ts does. There is no opt-out."
          }
        ]
      }
    ],
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "design-system/classname-passthrough": "error",
    "design-system/closed-variants": [
      "error",
      {
        "baseline": {
          "src/components/ui/airdesign-mark.tsx": 1,
          "src/components/ui/editor-icons.tsx": 1
        }
      }
    ],
    "design-system/icon-button-label": "error",
    "design-system/known-tokens": [
      "error",
      {
        "theme": ["src/index.css", "../../packages/theme/src/tokens.css"]
      }
    ],
    "design-system/layout-only-classname": [
      "error",
      {
        "baseline": {
          "src/account/account-name-page.tsx": 1,
          "src/account/name-form.tsx": 2,
          "src/aira/aira-history-menu.tsx": 2,
          "src/aira/aira-panel.tsx": 2,
          "src/aira/aira-reply.tsx": 1,
          "src/components/ai-elements/chain-of-thought.tsx": 2,
          "src/decks/connect-agent.tsx": 5,
          "src/decks/decks-shell.tsx": 1,
          "src/decks/describe-deck.tsx": 1,
          "src/decks/home.tsx": 1,
          "src/decks/new-deck-button.tsx": 1,
          "src/decks/screens/deck-moved-toast.tsx": 1,
          "src/design/color-picker.tsx": 1,
          "src/design/controls/action.tsx": 1,
          "src/design/controls/alignment-grid.tsx": 1,
          "src/design/controls/preset.tsx": 2,
          "src/design/controls/toggle.tsx": 1,
          "src/design/controls/typography.tsx": 5,
          "src/design/custom-color.tsx": 1,
          "src/design/shape-grid.tsx": 1,
          "src/editor/deck-title-edit.tsx": 2,
          "src/editor/design-sections.tsx": 3,
          "src/editor/design-theme-picker.tsx": 3,
          "src/editor/editor-chrome.tsx": 1,
          "src/editor/editor-toast.tsx": 1,
          "src/editor/editor-toolbar.tsx": 4,
          "src/editor/hidden-locked.tsx": 1,
          "src/editor/panel-toggle.tsx": 1,
          "src/editor/shape-tool.tsx": 3,
          "src/editor/slide-sidebar.tsx": 1,
          "src/editor/zoom-menu.tsx": 1,
          "src/export/export-dialog.tsx": 6,
          "src/settings/account-card.tsx": 1,
          "src/settings/agents-empty.tsx": 1,
          "src/settings/agents-page.tsx": 1,
          "src/settings/screens/agents-tab.tsx": 1,
          "src/settings/screens/usage-tab.tsx": 1
        }
      }
    ],
    "design-system/no-duplicate-primitives": "error",
    "design-system/no-important": [
      "error",
      {
        "baseline": {
          "src/settings/screens/usage-tab.tsx": 6
        }
      }
    ],
    "design-system/no-raw-values": [
      "error",
      {
        "baseline": {
          "src/account/account-name-page.tsx": 3,
          "src/components/ui/card.tsx": 1,
          "src/components/ui/switch.tsx": 1,
          "src/decks/agent-promo.tsx": 4,
          "src/decks/connect-agent.tsx": 1,
          "src/decks/screens/trash-list.tsx": 1,
          "src/editor/editor-toast.tsx": 2,
          "src/export/export-dialog.tsx": 1
        }
      }
    ],
    "design-system/no-reach-in-selectors": [
      "error",
      {
        "baseline": {
          "src/editor/design-theme-picker.tsx": 2
        }
      }
    ],
    "design-system/no-rebuilt-primitives": [
      "error",
      {
        "baseline": {
          "src/aira/aira-reply.tsx": 1,
          "src/components/ai-elements/conversation.tsx": 1,
          "src/components/ai-elements/prompt-input.tsx": 1,
          "src/connect/approve-agent.tsx": 1,
          "src/decks/agent-promo.tsx": 2,
          "src/decks/connect-agent.tsx": 2,
          "src/decks/decks-shell.tsx": 2,
          "src/decks/describe-deck.tsx": 2,
          "src/decks/screens/deck-moved-toast.tsx": 1,
          "src/design/controls/link.tsx": 1,
          "src/design/custom-color.tsx": 1,
          "src/editor/actions-popover.tsx": 1,
          "src/editor/agent-at-work.tsx": 1,
          "src/editor/design-sections.tsx": 1,
          "src/editor/grid-card.tsx": 1,
          "src/editor/new-slide-menu.tsx": 2,
          "src/editor/notes-bar.tsx": 1,
          "src/editor/slide-list-item.tsx": 1,
          "src/editor/zoom-menu.tsx": 1,
          "src/export/export-dialog.tsx": 1,
          "src/present/present-show.tsx": 1,
          "src/present/presenter-view.tsx": 1
        }
      }
    ],
    "design-system/no-template-classname": [
      "error",
      {
        "baseline": {}
      }
    ],
    "design-system/one-way-imports": [
      "error",
      {
        "layers": ["src/lib", "src/copy", "src/components/ui", "src/components", "src"]
      }
    ],
    "design-system/prefer-shorthand": [
      "error",
      {
        "baseline": {}
      }
    ],
    "design-system/primitive-naming": "error",
    "design-system/wrapped-libraries": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludeFiles": ["src/components/ui/toast.tsx", "src/components/ui/toast.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "sonner",
                "importNames": ["toast"],
                "message": "Use @/components/ui/toast so actions and recovery instructions stay dismissible."
              }
            ]
          }
        ]
      }
    }
  ],
  "jsPlugins": [
    {
      "name": "design-system",
      "specifier": "outtrue"
    }
  ],
  "settings": {
    "design-system": {
      "primitives": "src/components/ui"
    }
  }
}
