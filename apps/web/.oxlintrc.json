{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludeFiles": ["src/components/ui/toast.tsx", "src/components/ui/toast.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "sonner",
                "importNames": ["toast"],
                "message": "Use @/components/ui/toast so actions and recovery instructions stay dismissible."
              }
            ]
          }
        ]
      }
    }
  ]
}
