{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "airdesign://contracts/document/v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "schemaVersion",
    "title",
    "status",
    "freezeIn",
    "acceptIn",
    "owner",
    "source",
    "rule",
    "alternatives",
    "examples",
    "counterexamples",
    "evidence",
    "migration"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "gitSha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "gitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "policy",
        "from"
      ],
      "properties": {
        "policy": {
          "const": "additive-only"
        },
        "from": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
