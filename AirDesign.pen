                    {
                      "type": "frame",
                      "id": "wHTjv",
                      "name": "Code",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 20,
                      "children": [
                        {
                          "type": "text",
                          "id": "k4gnr8",
                          "fill": "$fg-default",
                          "content": "Code",
                          "lineHeight": 1.3,
                          "fontFamily": "$font-display",
                          "fontSize": 22,
                          "fontWeight": "600"
                        },
                        {
                          "type": "frame",
                          "id": "mmLXp",
                          "width": "fill_container",
                          "fill": "$bg-inverse",
                          "cornerRadius": "$r-lg",
                          "padding": 20,
                          "children": [
                            {
                              "type": "text",
                              "id": "n1f6dl",
                              "fill": "$fg-inverse",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "<div class=\"contrail\" role=\"status\" aria-label=\"Agent is working on Linen edit email\">\n  <!-- 54 spans: 3 rows × 18 columns, row by row -->\n</div>\n\n.contrail {\n  display: grid;\n  grid-template-columns: repeat(18, 3px);\n  grid-template-rows: repeat(3, 3px);\n  gap: 3px;\n}\n.contrail span { border-radius: 50%; background: var(--accent-ai); }\n.contrail span.head { background: var(--accent-brand); }\n\nconst COLS = 18, TRAIL = 6, HUM = 0.12;\nconst cells = el.querySelectorAll('span');      // index = row * COLS + col\nconst row = (c) => Math.max(0, 2 - Math.round(c * Math.tan(Math.PI / 12))); // 15°\nconst hum = new Float32Array(cells.length);\nconst still = matchMedia('(prefers-reduced-motion: reduce)').matches;\n\nfunction draw(head, trail) {\n  cells.forEach((s, i) => { s.className = ''; s.style.opacity = hum[i]; });\n  for (let age = 0; age < trail && head - age >= 0; age++) {\n    const c = head - age, s = cells[row(c) * COLS + c];\n    if (age === 0) { s.className = 'head'; s.style.opacity = 1; }\n    else s.style.opacity = 1 - 0.8 * (age / trail);\n  }\n}\n\nlet step = 0;\nfunction tick() {\n  if (step % 2 === 0) hum.forEach((_, i) => (hum[i] = Math.random() < HUM ? 0.35 : 0));\n  const h = step++ % (COLS + 4);                 // 4-step pause between takeoffs\n  draw(h < COLS ? h : -1, TRAIL);\n}\nconst timer = still ? (draw(COLS - 1, COLS), null) : setInterval(tick, 60);\n// when the agent is done: clearInterval(timer), fade the strip out over 150 ms",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "r2rctf",
                          "fill": "$fg-default",
                          "content": "Build: board, boxes, content",
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "frame",
                          "id": "BUnbv",
                          "width": "fill_container",
                          "fill": "$bg-inverse",
                          "cornerRadius": "$r-lg",
                          "padding": 20,
                          "children": [
                            {
                              "type": "text",
                              "id": "fA2lE",
                              "fill": "$fg-inverse",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "/* 1. Board pops in: no slide */\n.board {\n  transition:\n    opacity 500ms cubic-bezier(var(--ease-pop)),\n    scale 550ms cubic-bezier(var(--ease-pop));\n  @starting-style { opacity: 0; scale: 0.94; }\n}\n\n/* 2–3. Outlines draw open from the top-left corner (clipped, not scaled) */\n.board-outline, .slot {\n  clip-path: inset(0 calc(100% - var(--w)) calc(100% - var(--h)) 0);\n  opacity: 0;\n}\n.board-outline { --w: 14px; --h: 12px; border: 1px solid var(--accent-ai); }   /* the frame: solid */\n.slot { --w: 10px; --h: 8px; border: 1px solid var(--accent-ai); border-radius: 2px; }  /* reserved space */\n.is-open {\n  clip-path: inset(0);\n  opacity: 1;\n  transition:\n    clip-path var(--motion-draw) cubic-bezier(var(--ease-draw)),\n    opacity 120ms linear;\n}\n\n/* 4. Content in, box out */\n.slot.is-done { opacity: 0; transition: opacity 320ms 80ms ease-out; }\n.piece-content {\n  transition:\n    opacity var(--motion-content) ease-out,\n    translate var(--motion-content) ease-out;\n  @starting-style { opacity: 0; translate: 0 6px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .board, .piece-content { scale: 1; translate: none; transition: opacity var(--motion-fast); }\n  .board-outline, .slot { clip-path: none; transition: opacity var(--motion-fast); }\n}",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
