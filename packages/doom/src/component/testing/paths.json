{
  "version": 1,
  "name": "Path geometry fixtures",
  "collections": {},
  "defaults": { "ink": "#203A66" },
  "let": [
    ["center", ["point", 0.5, 0.5]],
    [
      "points",
      [
        "list",
        { "id": "start", "x": 0, "y": 0.8 },
        { "id": "rise", "x": 0.35, "y": 0.2 },
        { "id": "dip", "x": 0.65, "y": 0.65 },
        { "id": "end", "x": 1, "y": 0.1 }
      ]
    ]
  ],
  "parts": [
    {
      "emit": {
        "kind": "path",
        "key": ["list", "pie"],
        "x": 180,
        "y": 360,
        "w": 360,
        "h": 360,
        "d": ["wedge", ["get", "center"], 0, 0.5, 0.1, 0.75],
        "fillStroke": true,
        "fill": "#203A66"
      }
    },
    {
      "emit": {
        "kind": "path",
        "key": ["list", "pie-sector"],
        "x": 180,
        "y": 360,
        "w": 360,
        "h": 360,
        "d": ["wedge", ["get", "center"], 0, 0.5, -0.25, 0.1],
        "fillStroke": true,
        "fill": "#6091D2"
      }
    },
    {
      "emit": {
        "kind": "path",
        "key": ["list", "donut"],
        "x": 690,
        "y": 360,
        "w": 360,
        "h": 360,
        "d": ["wedge", ["get", "center"], 0.29, 0.5, 0.1, 0.75],
        "fillStroke": true,
        "fill": "#203A66"
      }
    },
    {
      "emit": {
        "kind": "path",
        "key": ["list", "donut-sector"],
        "x": 690,
        "y": 360,
        "w": 360,
        "h": 360,
        "d": ["wedge", ["get", "center"], 0.29, 0.5, -0.25, 0.1],
        "fillStroke": true,
        "fill": "#6091D2"
      }
    },
    {
      "emit": {
        "kind": "path",
        "key": ["list", "polyline"],
        "x": 1200,
        "y": 360,
        "w": 540,
        "h": 360,
        "d": ["polyline", ["map", ["get", "points"], "p", ["point", ["get", "p.x"], ["get", "p.y"]]]],
        "stroke": { "color": ["get", "token.ink"], "width": 14 }
      }
    },
    {
      "repeat": { "over": ["get", "points"], "as": "marker" },
      "when": ["if", ["eq", ["get", "marker.id"], "dip"], false, true],
      "emit": {
        "kind": "rect",
        "key": ["list", "marker", ["get", "marker.id"]],
        "x": ["sub", ["add", 1200, ["mul", ["get", "marker.x"], 540]], 10],
        "y": ["sub", ["add", 360, ["mul", ["get", "marker.y"], 360]], 10],
        "w": 20,
        "h": 20,
        "fill": "#6091D2"
      }
    }
  ]
}
