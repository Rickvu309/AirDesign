{
  "version": 1,
  "name": "Chart",
  "chart": "cartesian",
  "collections": {
    "rows": {
      "label": "string",
      "value": "number?"
    }
  },
  "variants": {
    "labels": [true, false],
    "legend": [true, false],
    "signed": [true, false]
  },
  "defaultVariant": {
    "labels": true,
    "legend": false,
    "signed": false
  },
  "defaults": {
    "scale": 1,
    "digits": "auto",
    "prefix": "",
    "suffix": "",
    "unitHeader": "",
    "unitPlace": "header",
    "title": "",
    "ink": {
      "var": "text"
    },
    "muted": {
      "var": "text2"
    },
    "rule": "#93A6BA",
    "accent": {
      "var": "accent1"
    },
    "positive": {
      "var": "positive"
    },
    "negative": {
      "var": "negative"
    },
    "seriesLabel": "Series",
    "positiveLabel": "Positive",
    "negativeLabel": "Negative",
    "heading": "label",
    "label": "label",
    "caption": "caption",
    "captionSmall": 18
  },
  "let": [
    ["gutter", 12],
    ["rowCount", ["count", ["get", "data.rows"]]],
    ["plotWidth", ["sub", ["get", "frame.w"], ["mul", 2, ["get", "gutter"]]]],
    ["laneWidth", ["div", ["get", "plotWidth"], ["max", 1, ["get", "rowCount"]]]],
    ["markWidth", ["mul", ["get", "laneWidth"], 0.57]],
    ["markInset", ["div", ["sub", ["get", "laneWidth"], ["get", "markWidth"]], 2]],
    ["plotTop", 99],
    ["values", ["map", ["get", "data.rows"], "r", ["if", ["eq", ["get", "r.value"], null], 0, ["get", "r.value"]]]],
    ["lo", ["min", 0, ["get", "values"]]],
    ["maxValue", ["max", 0, ["get", "values"]]],
    ["hi", ["max", 1, ["get", "maxValue"]]],
    ["categorySpace", 62],
    ["valueSpace", ["if", ["get", "variant.labels"], ["if", ["lt", ["get", "lo"], 0], 44, 12], 12]],
    ["legendLeading", 26],
    ["legendRowHeight", 32],
    [
      "legendRoom",
      ["sub", ["get", "frame.h"], ["add", ["get", "plotTop"], 48, ["get", "categorySpace"], ["get", "valueSpace"]]]
    ],
    [
      "legend",
      [
        "if",
        ["get", "variant.legend"],
        [
          "flowText",
          [
            "if",
            ["get", "variant.signed"],
            [
              "filter",
              [
                "list",
                {
                  "id": "positive",
                  "chars": ["get", "token.positiveLabel"],
                  "fill": ["get", "token.positive"],
                  "show": ["lt", 0, ["get", "maxValue"]]
                },
                {
                  "id": "negative",
                  "chars": ["get", "token.negativeLabel"],
                  "fill": ["get", "token.negative"],
                  "show": ["lt", ["get", "lo"], 0]
                }
              ],
              "item",
              ["get", "item.show"]
            ],
            ["list", { "id": "series", "chars": ["get", "token.seriesLabel"], "fill": ["get", "token.accent"] }]
          ],
          {
            "width": ["max", 0, ["get", "plotWidth"]],
            "rows": [
              "if",
              ["lt", ["get", "legendRoom"], ["get", "legendRowHeight"]],
              0,
              ["if", ["lt", ["get", "legendRoom"], ["mul", 2, ["get", "legendRowHeight"]]], 1, 2]
            ],
            "rowHeight": ["get", "legendRowHeight"],
            "leading": ["get", "legendLeading"],
            "gap": 22,
            "style": ["get", "token.caption"],
            "smaller": ["get", "token.captionSmall"]
          }
        ],
        { "items": ["list"], "rows": 0 }
      ]
    ],
    ["legendTop", ["sub", ["get", "frame.h"], ["mul", ["get", "legend.rows"], ["get", "legendRowHeight"]]]],
    ["categoryTop", ["sub", ["get", "legendTop"], ["get", "categorySpace"]]],
    ["plotBottom", ["sub", ["get", "categoryTop"], ["get", "valueSpace"]]],
    ["headerUnit", ["if", ["eq", ["get", "token.unitPlace"], "header"], ["get", "token.unitHeader"], ""]],
    [
      "header",
      [
        "if",
        ["eq", ["get", "token.title"], ""],
        ["get", "headerUnit"],
        [
          "if",
          ["eq", ["get", "headerUnit"], ""],
          ["get", "token.title"],
          ["concat", ["get", "token.title"], ", ", ["get", "headerUnit"]]
        ]
      ]
    ],
    [
      "valueFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": [
          "if",
          ["eq", ["get", "token.digits"], "auto"],
          ["decimals", ["get", "values"], ["get", "token.scale"]],
          ["get", "token.digits"]
        ],
        "prefix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.prefix"], ""],
        "suffix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.suffix"], ""],
        "sign": "negative"
      }
    ],
    ["zero", ["linear", 0, ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]]
  ],
  "parts": [
    {
      "when": ["if", ["eq", ["get", "header"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "unit"],
        "x": 0,
        "y": 0,
        "w": ["get", "frame.w"],
        "h": 42,
        "chars": ["get", "header"],
        "style": ["get", "token.heading"],
        "color": ["get", "token.ink"],
        "align": "left",
        "alignV": "center"
      }
    },
    {
      "emit": {
        "kind": "line",
        "key": ["list", "zero"],
        "start": ["point", ["get", "gutter"], ["get", "zero"]],
        "end": ["point", ["sub", ["get", "frame.w"], ["get", "gutter"]], ["get", "zero"]],
        "color": ["get", "token.rule"],
        "width": 2,
        "route": "straight",
        "arrow": "none"
      }
    },
    {
      "repeat": {
        "over": ["get", "data.rows"],
        "as": "r"
      },
      "let": [["laneStart", ["add", ["get", "gutter"], ["mul", ["get", "i"], ["get", "laneWidth"]]]]],
      "children": [
        {
          "emit": {
            "kind": "text",
            "key": ["list", "category", ["get", "r.id"]],
            "x": ["get", "laneStart"],
            "y": ["get", "categoryTop"],
            "w": ["get", "laneWidth"],
            "h": 56,
            "chars": ["get", "r.label"],
            "style": ["get", "token.caption"],
            "color": ["get", "token.muted"],
            "align": "center",
            "alignV": "center",
            "fit": { "smaller": ["get", "token.captionSmall"], "group": "categories", "thin": 4 }
          }
        },
        {
          "when": ["if", ["eq", ["get", "r.value"], null], false, true],
          "children": [
            {
              "let": [
                [
                  "edge",
                  [
                    "linear",
                    ["get", "r.value"],
                    ["get", "lo"],
                    ["get", "hi"],
                    ["get", "plotBottom"],
                    ["get", "plotTop"]
                  ]
                ]
              ],
              "children": [
                {
                  "emit": {
                    "kind": "rect",
                    "key": ["list", "bar", ["get", "r.id"]],
                    "x": ["add", ["get", "laneStart"], ["get", "markInset"]],
                    "y": ["min", ["get", "zero"], ["get", "edge"]],
                    "w": ["get", "markWidth"],
                    "h": [
                      "max",
                      2,
                      ["sub", ["get", "edge"], ["get", "zero"]],
                      ["sub", ["get", "zero"], ["get", "edge"]]
                    ],
                    "fill": [
                      "if",
                      ["get", "variant.signed"],
                      [
                        "if",
                        ["lt", ["get", "r.value"], 0],
                        ["get", "token.negative"],
                        ["if", ["lt", 0, ["get", "r.value"]], ["get", "token.positive"], ["get", "token.accent"]]
                      ],
                      ["get", "token.accent"]
                    ]
                  }
                },
                {
                  "when": ["get", "variant.labels"],
                  "emit": {
                    "kind": "text",
                    "key": ["list", "value", ["get", "r.id"]],
                    "x": ["get", "laneStart"],
                    "y": [
                      "if",
                      ["lt", ["get", "r.value"], 0],
                      ["add", ["get", "edge"], 5],
                      ["sub", ["get", "edge"], 37]
                    ],
                    "w": ["get", "laneWidth"],
                    "h": 32,
                    "chars": ["format", ["get", "r.value"], ["get", "valueFormat"]],
                    "style": ["get", "token.label"],
                    "color": ["get", "token.ink"],
                    "align": "center",
                    "alignV": "center",
                    "fit": "omit"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "repeat": { "over": ["get", "legend.items"], "as": "placed" },
      "let": [
        ["x", ["add", ["get", "gutter"], ["get", "placed.x"]]],
        ["y", ["add", ["get", "legendTop"], ["mul", ["get", "placed.row"], ["get", "legendRowHeight"]]]]
      ],
      "children": [
        {
          "emit": {
            "kind": "rect",
            "key": ["list", "legend-swatch", ["get", "placed.item.id"]],
            "x": ["get", "x"],
            "y": ["add", ["get", "y"], ["div", ["sub", ["get", "legendRowHeight"], 16], 2]],
            "w": 16,
            "h": 16,
            "fill": ["get", "placed.item.fill"]
          }
        },
        {
          "emit": {
            "kind": "text",
            "key": ["list", "legend-label", ["get", "placed.item.id"]],
            "x": ["add", ["get", "x"], ["get", "legendLeading"]],
            "y": ["get", "y"],
            "w": ["get", "placed.w"],
            "h": ["get", "legendRowHeight"],
            "chars": ["get", "placed.item.chars"],
            "style": ["get", "token.caption"],
            "size": ["get", "legend.size"],
            "color": ["get", "token.muted"],
            "align": "left",
            "alignV": "center"
          }
        }
      ]
    }
  ]
}
