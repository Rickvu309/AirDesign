{
  "version": 1,
  "name": "Chart",
  "chart": "cartesian",
  "sample": {
    "w": 1540,
    "h": 650,
    "data": {
      "rows": [
        {
          "id": "q1",
          "label": "Q1",
          "value": 12
        },
        {
          "id": "q2",
          "label": "Q2",
          "value": 19
        },
        {
          "id": "q3",
          "label": "Q3",
          "value": 15
        },
        {
          "id": "q4",
          "label": "Q4",
          "value": 24
        }
      ]
    }
  },
  "collections": {
    "rows": {
      "label": "string",
      "value": "number?"
    }
  },
  "variants": {
    "labels": [true, false],
    "legend": [true, false],
    "signed": [true, false]
  },
  "defaultVariant": {
    "labels": true,
    "legend": false,
    "signed": false
  },
  "defaults": {
    "scale": 1,
    "digits": "auto",
    "prefix": "",
    "suffix": "",
    "unitHeader": "",
    "unitPlace": "header",
    "title": "",
    "ink": {
      "var": "text"
    },
    "muted": {
      "var": "text2"
    },
    "rule": {
      "var": "text2"
    },
    "accent": {
      "var": "accent1"
    },
    "positive": {
      "var": "positive"
    },
    "negative": {
      "var": "negative"
    },
    "seriesLabel": "",
    "neutral": {
      "var": "text2"
    },
    "positiveLabel": "Positive",
    "negativeLabel": "Negative",
    "heading": "label",
    "label": "label",
    "caption": "caption",
    "captionSmall": "auto"
  },
  "let": [
    ["gutter", 12],
    ["seriesAccent", ["paletteRamp", 0, 1, ["get", "token.accent"], ["get", "token.neutral"]]],
    ["activeFocus", ["matchingFocus", ["get", "focus"], ["get", "data.rows"], "id", "value"]],
    ["hasFocus", ["lt", 0, ["count", ["get", "activeFocus"]]]],
    ["signColors", ["if", ["get", "hasFocus"], false, ["get", "variant.signed"]]],
    ["captionSmall", ["fitSize", ["get", "token.captionSmall"]]],
    ["rowCount", ["count", ["get", "data.rows"]]],
    ["values", ["map", ["get", "data.rows"], "r", ["if", ["eq", ["get", "r.value"], null], 0, ["get", "r.value"]]]],
    ["lo", ["min", 0, ["get", "values"]]],
    ["maxValue", ["max", 0, ["get", "values"]]],
    ["hi", ["max", 1, ["get", "maxValue"]]],
    [
      "valueFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": [
          "if",
          ["eq", ["get", "token.digits"], "auto"],
          ["decimals", ["get", "values"], ["get", "token.scale"]],
          ["get", "token.digits"]
        ],
        "prefix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.prefix"], ""],
        "suffix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.suffix"], ""],
        "sign": "negative"
      }
    ],
    [
      "labelLane",
      ["floor", ["div", ["sub", ["get", "frame.w"], ["mul", 2, ["get", "gutter"]]], ["max", 1, ["get", "rowCount"]]]]
    ],
    [
      "showValues",
      [
        "if",
        ["get", "variant.labels"],
        [
          "every",
          ["get", "data.rows"],
          "r",
          [
            "if",
            ["eq", ["get", "r.value"], null],
            true,
            [
              "if",
              [
                "lt",
                ["get", "labelLane"],
                [
                  "add",
                  [
                    "textWidth",
                    ["format", ["get", "r.value"], ["get", "valueFormat"], "measure"],
                    ["get", "token.label"]
                  ],
                  8
                ]
              ],
              false,
              true
            ]
          ]
        ],
        false
      ]
    ],
    [
      "axis",
      [
        "if",
        ["if", ["get", "showValues"], true, ["every", ["get", "data.rows"], "r", ["eq", ["get", "r.value"], null]]],
        {
          "lo": ["get", "lo"],
          "hi": ["get", "hi"],
          "step": 0,
          "ticks": ["list"]
        },
        ["axis", ["get", "lo"], ["get", "hi"], 3]
      ]
    ],
    [
      "axisFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": [
          "max",
          [
            "if",
            ["eq", ["get", "token.digits"], "auto"],
            ["decimals", ["get", "values"], ["get", "token.scale"]],
            ["get", "token.digits"]
          ],
          ["resolutionDigits", ["div", ["get", "axis.step"], ["get", "token.scale"]]]
        ],
        "prefix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.prefix"], ""],
        "suffix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.suffix"], ""],
        "sign": "negative"
      }
    ],
    [
      "ticks",
      [
        "map",
        ["get", "axis.ticks"],
        "v",
        {
          "id": ["get", "v.id"],
          "value": ["get", "v.value"],
          "chars": ["format", ["get", "v.value"], ["get", "axisFormat"], "measure"]
        }
      ]
    ],
    [
      "tickWidth",
      [
        "min",
        ["div", ["get", "frame.w"], 3],
        [
          "add",
          1,
          ["max", 0, ["map", ["get", "ticks"], "t", ["textWidth", ["get", "t.chars"], ["get", "token.caption"]]]]
        ]
      ]
    ],
    [
      "plotLeft",
      [
        "if",
        ["eq", ["count", ["get", "ticks"]], 0],
        ["get", "gutter"],
        ["add", ["get", "gutter"], ["get", "tickWidth"], 8]
      ]
    ],
    ["plotWidth", ["sub", ["get", "frame.w"], ["add", ["get", "plotLeft"], ["get", "gutter"]]]],
    ["laneWidth", ["div", ["get", "plotWidth"], ["max", 1, ["get", "rowCount"]]]],
    ["plotTop", 99],
    ["categorySpace", 62],
    ["valueSpace", ["if", ["get", "showValues"], ["if", ["lt", ["get", "lo"], 0], 44, 12], 12]],
    ["legendLeading", 26],
    ["legendRowHeight", 32],
    [
      "legendRoom",
      ["sub", ["get", "frame.h"], ["add", ["get", "plotTop"], 48, ["get", "categorySpace"], ["get", "valueSpace"]]]
    ],
    [
      "legend",
      [
        "if",
        ["get", "variant.legend"],
        [
          "flowText",
          [
            "if",
            ["get", "signColors"],
            [
              "filter",
              [
                "list",
                {
                  "id": "positive",
                  "chars": ["get", "token.positiveLabel"],
                  "fill": ["get", "token.positive"],
                  "show": ["lt", 0, ["get", "maxValue"]]
                },
                {
                  "id": "negative",
                  "chars": ["get", "token.negativeLabel"],
                  "fill": ["get", "token.negative"],
                  "show": ["lt", ["get", "lo"], 0]
                }
              ],
              "item",
              ["get", "item.show"]
            ],
            [
              "list",
              {
                "id": "series",
                "chars": ["get", "token.seriesLabel"],
                "fill": ["get", "seriesAccent"]
              }
            ]
          ],
          {
            "width": ["max", 0, ["get", "plotWidth"]],
            "rows": [
              "if",
              ["lt", ["get", "legendRoom"], ["get", "legendRowHeight"]],
              0,
              ["if", ["lt", ["get", "legendRoom"], ["mul", 2, ["get", "legendRowHeight"]]], 1, 2]
            ],
            "rowHeight": ["get", "legendRowHeight"],
            "leading": ["get", "legendLeading"],
            "gap": 22,
            "style": ["get", "token.caption"],
            "smaller": ["get", "captionSmall"]
          }
        ],
        {
          "items": ["list"],
          "rows": 0
        }
      ]
    ],
    ["legendTop", ["sub", ["get", "frame.h"], ["mul", ["get", "legend.rows"], ["get", "legendRowHeight"]]]],
    ["categoryTop", ["sub", ["get", "legendTop"], ["get", "categorySpace"]]],
    ["plotBottom", ["sub", ["get", "categoryTop"], ["get", "valueSpace"]]],
    ["zero", ["linear", 0, ["get", "axis.lo"], ["get", "axis.hi"], ["get", "plotBottom"], ["get", "plotTop"]]]
  ],
  "parts": [
    {
      "when": ["if", ["eq", ["get", "header"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "unit"],
        "x": 0,
        "y": 0,
        "w": ["get", "frame.w"],
        "h": 42,
        "chars": ["get", "header"],
        "style": ["get", "token.heading"],
        "color": ["get", "token.ink"],
        "align": "left",
        "alignV": "center"
      },
      "let": [
        ["headerUnit", ["if", ["eq", ["get", "token.unitPlace"], "header"], ["get", "token.unitHeader"], ""]],
        [
          "header",
          [
            "if",
            ["eq", ["get", "token.title"], ""],
            ["get", "headerUnit"],
            [
              "if",
              ["eq", ["get", "headerUnit"], ""],
              ["get", "token.title"],
              ["concat", ["get", "token.title"], ", ", ["get", "headerUnit"]]
            ]
          ]
        ]
      ]
    },
    {
      "repeat": {
        "over": ["get", "ticks"],
        "as": "t"
      },
      "let": [
        [
          "y",
          [
            "linear",
            ["get", "t.value"],
            ["get", "axis.lo"],
            ["get", "axis.hi"],
            ["get", "plotBottom"],
            ["get", "plotTop"]
          ]
        ]
      ],
      "children": [
        {
          "when": ["if", ["eq", ["get", "t.value"], 0], false, true],
          "emit": {
            "kind": "line",
            "key": ["list", "grid", ["get", "t.id"]],
            "start": ["point", ["get", "plotLeft"], ["get", "y"]],
            "end": ["point", ["sub", ["get", "frame.w"], ["get", "gutter"]], ["get", "y"]],
            "color": {
              "var": "text2",
              "tint": 0.8
            },
            "width": 1,
            "route": "straight",
            "arrow": "none"
          }
        },
        {
          "emit": {
            "kind": "text",
            "key": ["list", "tick", ["get", "t.id"]],
            "x": 0,
            "y": ["sub", ["get", "y"], 16],
            "w": ["get", "tickWidth"],
            "h": 32,
            "chars": ["get", "t.chars"],
            "style": ["get", "token.caption"],
            "color": ["get", "token.muted"],
            "align": "right",
            "alignV": "center",
            "fit": "omit"
          }
        }
      ]
    },
    {
      "emit": {
        "kind": "line",
        "key": ["list", "zero"],
        "start": ["point", ["get", "plotLeft"], ["get", "zero"]],
        "end": ["point", ["sub", ["get", "frame.w"], ["get", "gutter"]], ["get", "zero"]],
        "color": ["get", "token.rule"],
        "width": 2,
        "route": "straight",
        "arrow": "none"
      }
    },
    {
      "let": [
        ["markWidth", ["mul", ["get", "laneWidth"], 0.57]],
        ["markInset", ["div", ["sub", ["get", "laneWidth"], ["get", "markWidth"]], 2]],
        ["neutralMark", ["paletteRamp", 1, 2, ["get", "token.accent"], ["get", "token.neutral"], ["get", "showValues"]]]
      ],
      "children": [
        {
          "repeat": {
            "over": ["get", "data.rows"],
            "as": "r"
          },
          "let": [
            ["laneStart", ["add", ["get", "plotLeft"], ["mul", ["get", "i"], ["get", "laneWidth"]]]],
            ["hasValue", ["if", ["eq", ["get", "r.value"], null], false, true]],
            [
              "edge",
              [
                "if",
                ["get", "hasValue"],
                [
                  "linear",
                  ["get", "r.value"],
                  ["get", "axis.lo"],
                  ["get", "axis.hi"],
                  ["get", "plotBottom"],
                  ["get", "plotTop"]
                ],
                0
              ]
            ]
          ],
          "children": [
            {
              "emit": {
                "kind": "text",
                "key": ["list", "category", ["get", "r.id"]],
                "x": ["get", "laneStart"],
                "y": ["get", "categoryTop"],
                "w": ["get", "laneWidth"],
                "h": 56,
                "chars": ["get", "r.label"],
                "style": ["get", "token.caption"],
                "color": ["get", "token.muted"],
                "align": "center",
                "alignV": "center",
                "fit": {
                  "smaller": ["get", "captionSmall"],
                  "group": "categories",
                  "thin": 4
                }
              }
            },
            {
              "when": ["get", "hasValue"],
              "children": [
                {
                  "emit": {
                    "kind": "rect",
                    "key": ["list", "bar", ["get", "r.id"]],
                    "x": ["add", ["get", "laneStart"], ["get", "markInset"]],
                    "y": ["min", ["get", "zero"], ["get", "edge"]],
                    "w": ["get", "markWidth"],
                    "h": [
                      "max",
                      2,
                      ["sub", ["get", "edge"], ["get", "zero"]],
                      ["sub", ["get", "zero"], ["get", "edge"]]
                    ],
                    "fill": [
                      "if",
                      ["get", "hasFocus"],
                      [
                        "focusColor",
                        ["get", "activeFocus"],
                        ["list", ["get", "r.id"]],
                        ["get", "seriesAccent"],
                        ["get", "neutralMark"]
                      ],
                      [
                        "if",
                        ["get", "signColors"],
                        [
                          "if",
                          ["lt", ["get", "r.value"], 0],
                          ["get", "token.negative"],
                          ["if", ["lt", 0, ["get", "r.value"]], ["get", "token.positive"], ["get", "seriesAccent"]]
                        ],
                        ["get", "seriesAccent"]
                      ]
                    ]
                  }
                },
                {
                  "when": ["get", "showValues"],
                  "emit": {
                    "kind": "text",
                    "key": ["list", "value", ["get", "r.id"]],
                    "x": ["get", "laneStart"],
                    "y": [
                      "if",
                      ["lt", ["get", "r.value"], 0],
                      ["add", ["get", "edge"], 5],
                      ["sub", ["get", "edge"], 37]
                    ],
                    "w": ["get", "laneWidth"],
                    "h": 32,
                    "chars": ["format", ["get", "r.value"], ["get", "valueFormat"]],
                    "style": ["get", "token.label"],
                    "color": ["get", "token.ink"],
                    "align": "center",
                    "alignV": "center"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "repeat": {
        "over": ["get", "legend.items"],
        "as": "placed"
      },
      "let": [
        ["x", ["add", ["get", "gutter"], ["get", "placed.x"]]],
        ["y", ["add", ["get", "legendTop"], ["mul", ["get", "placed.row"], ["get", "legendRowHeight"]]]]
      ],
      "children": [
        {
          "emit": {
            "kind": "rect",
            "key": ["list", "legend-swatch", ["get", "placed.item.id"]],
            "x": ["get", "x"],
            "y": ["add", ["get", "y"], ["div", ["sub", ["get", "legendRowHeight"], 16], 2]],
            "w": 16,
            "h": 16,
            "fill": ["get", "placed.item.fill"]
          }
        },
        {
          "emit": {
            "kind": "text",
            "key": ["list", "legend-label", ["get", "placed.item.id"]],
            "x": ["add", ["get", "x"], ["get", "legendLeading"]],
            "y": ["get", "y"],
            "w": ["get", "placed.w"],
            "h": ["get", "legendRowHeight"],
            "chars": ["get", "placed.item.chars"],
            "style": ["get", "token.caption"],
            "size": ["get", "legend.size"],
            "color": ["get", "token.muted"],
            "align": "left",
            "alignV": "center"
          }
        }
      ]
    },
    {
      "let": [
        [
          "valueLabelSpace",
          [
            "if",
            ["if", ["get", "variant.labels"], ["eq", ["get", "showValues"], false], false],
            [
              "advise",
              "value-label-space",
              "Value labels need more room. Show fewer categories or make the chart wider."
            ],
            false
          ]
        ],
        [
          "manyColumns",
          [
            "if",
            [
              "if",
              ["lt", 12, ["get", "rowCount"]],
              ["every", ["get", "data.rows"], "r", ["timeCategory", ["get", "r.label"]]],
              false
            ],
            ["advise", "many-columns", "Use a line chart to show the trend across more than 12 time periods."],
            false
          ]
        ]
      ],
      "children": []
    }
  ]
}
