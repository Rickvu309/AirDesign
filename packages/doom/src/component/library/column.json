{
  "version": 1,
  "name": "Chart",
  "collections": {
    "rows": {
      "label": "string",
      "value": "number?"
    }
  },
  "variants": {
    "labels": [true, false]
  },
  "defaultVariant": {
    "labels": true
  },
  "defaults": {
    "scale": 1,
    "digits": 0,
    "prefix": "",
    "suffix": "",
    "unitHeader": "",
    "unitPlace": "header",
    "title": "",
    "ink": {
      "var": "text"
    },
    "muted": {
      "var": "text2"
    },
    "rule": "#93A6BA",
    "accent": {
      "var": "accent1"
    },
    "heading": "label",
    "label": "label",
    "caption": "caption",
    "captionSmall": 18
  },
  "let": [
    ["gutter", 12],
    ["rowCount", ["count", ["get", "data.rows"]]],
    ["plotWidth", ["sub", ["get", "frame.w"], ["mul", 2, ["get", "gutter"]]]],
    ["laneWidth", ["div", ["get", "plotWidth"], ["max", 1, ["get", "rowCount"]]]],
    ["markWidth", ["mul", ["get", "laneWidth"], 0.57]],
    ["markInset", ["div", ["sub", ["get", "laneWidth"], ["get", "markWidth"]], 2]],
    ["plotTop", 99],
    ["categoryTop", ["sub", ["get", "frame.h"], 62]],
    ["values", ["map", ["get", "data.rows"], "r", ["if", ["eq", ["get", "r.value"], null], 0, ["get", "r.value"]]]],
    ["lo", ["min", 0, ["get", "values"]]],
    ["hi", ["max", 1, ["get", "values"]]],
    [
      "plotBottom",
      ["sub", ["get", "categoryTop"], ["if", ["get", "variant.labels"], ["if", ["lt", ["get", "lo"], 0], 44, 12], 12]]
    ],
    ["headerUnit", ["if", ["eq", ["get", "token.unitPlace"], "header"], ["get", "token.unitHeader"], ""]],
    [
      "header",
      [
        "if",
        ["eq", ["get", "token.title"], ""],
        ["get", "headerUnit"],
        [
          "if",
          ["eq", ["get", "headerUnit"], ""],
          ["get", "token.title"],
          ["concat", ["get", "token.title"], ", ", ["get", "headerUnit"]]
        ]
      ]
    ],
    [
      "valueFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": ["get", "token.digits"],
        "prefix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.prefix"], ""],
        "suffix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.suffix"], ""],
        "sign": "negative"
      }
    ],
    ["zero", ["linear", 0, ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]]
  ],
  "parts": [
    {
      "when": ["if", ["eq", ["get", "header"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "unit"],
        "x": 0,
        "y": 0,
        "w": ["get", "frame.w"],
        "h": 42,
        "chars": ["get", "header"],
        "style": ["get", "token.heading"],
        "color": ["get", "token.ink"],
        "align": "left",
        "alignV": "center"
      }
    },
    {
      "emit": {
        "kind": "line",
        "key": ["list", "zero"],
        "start": ["point", ["get", "gutter"], ["get", "zero"]],
        "end": ["point", ["sub", ["get", "frame.w"], ["get", "gutter"]], ["get", "zero"]],
        "color": ["get", "token.rule"],
        "width": 2,
        "route": "straight",
        "arrow": "none"
      }
    },
    {
      "repeat": {
        "over": ["get", "data.rows"],
        "as": "r"
      },
      "let": [["laneStart", ["add", ["get", "gutter"], ["mul", ["get", "i"], ["get", "laneWidth"]]]]],
      "children": [
        {
          "emit": {
            "kind": "text",
            "key": ["list", "category", ["get", "r.id"]],
            "x": ["get", "laneStart"],
            "y": ["get", "categoryTop"],
            "w": ["get", "laneWidth"],
            "h": 56,
            "chars": ["get", "r.label"],
            "style": ["get", "token.caption"],
            "color": ["get", "token.muted"],
            "align": "center",
            "alignV": "center",
            "fit": { "smaller": ["get", "token.captionSmall"], "group": "categories", "thin": 4 }
          }
        },
        {
          "when": ["if", ["eq", ["get", "r.value"], null], false, true],
          "children": [
            {
              "let": [
                [
                  "edge",
                  [
                    "linear",
                    ["get", "r.value"],
                    ["get", "lo"],
                    ["get", "hi"],
                    ["get", "plotBottom"],
                    ["get", "plotTop"]
                  ]
                ]
              ],
              "children": [
                {
                  "emit": {
                    "kind": "rect",
                    "key": ["list", "bar", ["get", "r.id"]],
                    "x": ["add", ["get", "laneStart"], ["get", "markInset"]],
                    "y": ["min", ["get", "zero"], ["get", "edge"]],
                    "w": ["get", "markWidth"],
                    "h": [
                      "max",
                      2,
                      ["sub", ["get", "edge"], ["get", "zero"]],
                      ["sub", ["get", "zero"], ["get", "edge"]]
                    ],
                    "fill": ["get", "token.accent"]
                  }
                },
                {
                  "when": ["get", "variant.labels"],
                  "emit": {
                    "kind": "text",
                    "key": ["list", "value", ["get", "r.id"]],
                    "x": ["get", "laneStart"],
                    "y": [
                      "if",
                      ["lt", ["get", "r.value"], 0],
                      ["add", ["get", "edge"], 5],
                      ["sub", ["get", "edge"], 37]
                    ],
                    "w": ["get", "laneWidth"],
                    "h": 32,
                    "chars": ["format", ["get", "r.value"], ["get", "valueFormat"]],
                    "style": ["get", "token.label"],
                    "color": ["get", "token.ink"],
                    "align": "center",
                    "alignV": "center",
                    "fit": "omit"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
