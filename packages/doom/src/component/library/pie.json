{
  "version": 1,
  "name": "Pie chart",
  "chart": "pie",
  "sample": {
    "w": 1540,
    "h": 650,
    "data": {
      "series": [{ "id": "share" }],
      "rows": [
        {
          "id": "s0",
          "label": "Enterprise",
          "value": 42
        },
        {
          "id": "s1",
          "label": "Mid-market",
          "value": 29
        },
        {
          "id": "s2",
          "label": "Small business",
          "value": 29
        }
      ]
    }
  },
  "collections": {
    "series": {},
    "rows": {
      "label": "string",
      "value": "number",
      "color": "color?"
    }
  },
  "variants": {
    "shape": ["pie", "donut"],
    "labels": [true, false],
    "groupSmall": [true, false]
  },
  "defaultVariant": {
    "shape": "pie",
    "labels": true,
    "groupSmall": true
  },
  "defaults": {
    "accent1": {
      "var": "accent1"
    },
    "ink": {
      "var": "text"
    },
    "muted": {
      "var": "text2"
    },
    "rule": {
      "var": "text2"
    },
    "caption": "caption",
    "heading": "label",
    "digits": "auto",
    "title": "",
    "darkInk": {
      "var": "text"
    },
    "lightInk": {
      "var": "background"
    },
    "captionSmall": 18
  },
  "let": [
    ["values", ["map", ["get", "data.rows"], "row", ["get", "row.value"]]],
    ["oneSeries", ["eq", ["count", ["get", "data.series"]], 1]],
    ["nonnegative", ["if", ["lt", ["min", 0, ["get", "values"]], 0], false, true]],
    ["divisor", ["if", ["lt", 0, ["max", 0, ["get", "values"]]], ["max", 0, ["get", "values"]], 1]],
    [
      "sourceRows",
      [
        "if",
        ["get", "nonnegative"],
        [
          "map",
          ["get", "data.rows"],
          "r",
          {
            "id": ["get", "r.id"],
            "label": ["get", "r.label"],
            "value": ["div", ["get", "r.value"], ["get", "divisor"]],
            "color": ["get", "r.color"],
            "rank": ["if", ["eq", ["get", "r.label"], "Other"], -1, ["get", "r.value"]]
          }
        ],
        ["list"]
      ]
    ],
    ["sliceLimit", 6],
    [
      "grouped",
      ["if", ["get", "variant.groupSmall"], ["lt", ["get", "sliceLimit"], ["count", ["get", "sourceRows"]]], false]
    ],
    [
      "selected",
      [
        "split-ranked",
        ["get", "sourceRows"],
        "rank",
        ["if", ["get", "grouped"], ["sub", ["get", "sliceLimit"], 1], ["count", ["get", "sourceRows"]]]
      ]
    ],
    [
      "displayRows",
      [
        "if",
        ["get", "grouped"],
        [
          "flatten",
          [
            "list",
            ["at", ["get", "selected"], 0],
            [
              "list",
              {
                "id": "other aggregate",
                "label": "Other",
                "value": ["sum", ["map", ["at", ["get", "selected"], 1], "row", ["get", "row.value"]]],
                "color": null,
                "rank": -1
              }
            ]
          ]
        ],
        ["at", ["get", "selected"], 0]
      ]
    ],
    ["total", ["sum", ["map", ["get", "displayRows"], "r", ["get", "r.value"]]]],
    [
      "colorSlots",
      [
        "rampSlots",
        ["get", "displayRows"],
        [
          "matchingFocus",
          ["get", "focus"],
          ["filter", ["at", ["get", "selected"], 0], "r", ["lt", ["mul", 1e-6, ["get", "total"]], ["get", "r.value"]]],
          "id"
        ]
      ]
    ],
    [
      "colors",
      [
        "map",
        ["get", "displayRows"],
        "r",
        [
          "coalesce",
          ["get", "r.color"],
          [
            "paletteRamp",
            ["at", ["get", "colorSlots.indices"], ["get", "i"]],
            ["get", "colorSlots.count"],
            ["get", "token.accent1"],
            ["get", "token.muted"],
            false
          ]
        ]
      ]
    ],
    [
      "digits",
      [
        "if",
        ["eq", ["get", "token.digits"], "auto"],
        [
          "decimals",
          [
            "if",
            ["lt", 0, ["get", "total"]],
            ["map", ["get", "displayRows"], "r", ["mul", 100, ["div", ["get", "r.value"], ["get", "total"]]]],
            ["list"]
          ],
          1
        ],
        ["get", "token.digits"]
      ]
    ],
    ["precision", ["pow10", ["get", "digits"]]],
    [
      "quota",
      ["allocate", ["map", ["get", "displayRows"], "row", ["get", "row.value"]], ["mul", 100, ["get", "precision"]]]
    ],
    [
      "valueFormat",
      {
        "scale": 1,
        "digits": ["get", "digits"],
        "prefix": "",
        "suffix": "%",
        "sign": "negative"
      }
    ],
    [
      "rows",
      [
        "map",
        ["get", "displayRows"],
        "r",
        {
          "id": ["get", "r.id"],
          "label": ["get", "r.label"],
          "value": ["get", "r.value"],
          "color": ["at", ["get", "colors"], ["get", "i"]],
          "percent": [
            "format",
            ["div", ["at", ["get", "quota"], ["get", "i"]], ["get", "precision"]],
            ["get", "valueFormat"]
          ]
        }
      ]
    ],
    ["valid", ["if", ["get", "oneSeries"], ["if", ["get", "nonnegative"], ["lt", 0, ["get", "total"]], false], false]],
    [
      "legend",
      [
        "if",
        ["get", "valid"],
        [
          "flowText",
          [
            "map",
            ["get", "rows"],
            "r",
            {
              "id": ["get", "r.id"],
              "color": ["get", "r.color"],
              "chars": ["concat", ["get", "r.label"], "  ·  ", ["get", "r.percent"]]
            }
          ],
          {
            "width": ["max", 0, ["sub", ["get", "frame.w"], 24]],
            "rows": ["max", 0, ["min", 4, ["floor", ["div", ["get", "frame.h"], 100]]]],
            "rowHeight": 32,
            "leading": 22,
            "gap": 22,
            "style": ["get", "token.caption"],
            "smaller": ["get", "token.captionSmall"]
          }
        ],
        {
          "size": ["get", "token.captionSmall"],
          "rows": 0,
          "items": ["list"]
        }
      ]
    ],
    ["legendTop", ["sub", ["get", "frame.h"], ["mul", 32, ["get", "legend.rows"]]]],
    ["titleH", ["if", ["eq", ["get", "token.title"], ""], 0, 48]],
    ["plotH", ["max", 0, ["sub", ["get", "legendTop"], ["get", "titleH"]]]],
    ["cx", ["div", ["get", "frame.w"], 2]],
    ["cy", ["add", ["get", "titleH"], ["div", ["get", "plotH"], 2]]],
    ["center", ["point", ["get", "cx"], ["get", "cy"]]],
    [
      "radius",
      [
        "max",
        0,
        [
          "min",
          ["sub", ["get", "cx"], ["min", 95, ["mul", ["get", "frame.w"], 0.24]]],
          ["sub", ["div", ["get", "plotH"], 2], 56]
        ]
      ]
    ],
    ["inner", ["if", ["eq", ["get", "variant.shape"], "donut"], ["mul", ["get", "radius"], 0.58], 0]],
    [
      "midRadius",
      [
        "add",
        ["get", "inner"],
        ["mul", ["sub", ["get", "radius"], ["get", "inner"]], ["if", ["eq", ["get", "inner"], 0], 0.61, 0.5]]
      ]
    ],
    [
      "visible",
      [
        "if",
        ["get", "valid"],
        ["filter", ["get", "rows"], "r", ["lt", 1e-6, ["div", ["get", "r.value"], ["get", "total"]]]],
        ["list"]
      ]
    ],
    ["visibleTotal", ["sum", ["map", ["get", "visible"], "r", ["get", "r.value"]]]],
    [
      "slices",
      [
        "scan",
        ["get", "visible"],
        "r",
        0,
        ["add", ["get", "acc"], ["get", "r.value"]],
        {
          "id": ["get", "r.id"],
          "from_": ["add", -0.25, ["div", ["get", "acc"], ["get", "visibleTotal"]]],
          "to": ["add", -0.25, ["div", ["get", "next"], ["get", "visibleTotal"]]],
          "span": ["div", ["get", "r.value"], ["get", "visibleTotal"]],
          "color": ["get", "r.color"],
          "percent": ["get", "r.percent"],
          "label": ["get", "r.label"]
        }
      ]
    ],
    ["canDraw", ["if", ["get", "valid"], ["lt", 0, ["get", "radius"]], false]]
  ],
  "parts": [
    {
      "emit": {
        "kind": "notice",
        "key": ["list", "many-slices"],
        "message": "Use a bar chart to compare more than six categories."
      },
      "when": ["lt", 6, ["count", ["get", "sourceRows"]]]
    },
    {
      "emit": {
        "kind": "notice",
        "key": ["list", "series"],
        "message": "Provide exactly one series for a pie or donut chart."
      },
      "when": ["if", ["get", "oneSeries"], false, true]
    },
    {
      "emit": {
        "kind": "notice",
        "key": ["list", "negative"],
        "message": "Pie and donut values must be zero or greater."
      },
      "when": ["if", ["get", "nonnegative"], false, true]
    },
    {
      "emit": {
        "kind": "notice",
        "key": ["list", "no-values"],
        "message": "Provide at least one positive slice value."
      },
      "when": [
        "if",
        ["if", ["get", "oneSeries"], ["get", "nonnegative"], false],
        ["if", ["get", "valid"], false, true],
        false
      ]
    },
    {
      "emit": {
        "kind": "notice",
        "key": ["list", "plot"],
        "message": "The chart frame is too small to draw the slices."
      },
      "when": ["if", ["get", "valid"], ["if", ["get", "canDraw"], false, true], false]
    },
    {
      "emit": {
        "kind": "notice",
        "key": ["list", "grouped"],
        "message": "Smaller slices were combined into Other. Turn off grouping to keep every slice."
      },
      "when": ["get", "grouped"]
    },
    {
      "emit": {
        "kind": "notice",
        "key": ["list", "repeated-colors"],
        "message": "Some slices share an assigned colour. Use distinct colours."
      },
      "when": ["lt", ["count", ["unique-colors", ["get", "explicitColors"]]], ["count", ["get", "explicitColors"]]],
      "let": [
        [
          "explicitColors",
          [
            "map",
            ["filter", ["get", "displayRows"], "r", ["if", ["eq", ["get", "r.color"], null], false, true]],
            "r",
            ["get", "r.color"]
          ]
        ]
      ]
    },
    {
      "when": ["get", "canDraw"],
      "children": [
        {
          "emit": {
            "kind": "text",
            "key": ["list", "title"],
            "x": 0,
            "y": 0,
            "w": ["get", "frame.w"],
            "h": 42,
            "chars": ["get", "token.title"],
            "style": ["get", "token.heading"],
            "color": ["get", "token.ink"],
            "align": "left",
            "alignV": "center",
            "fit": "omit"
          },
          "when": ["if", ["eq", ["get", "token.title"], ""], false, true]
        },
        {
          "repeat": {
            "over": ["get", "slices"],
            "as": "p"
          },
          "children": [
            {
              "emit": {
                "kind": "path",
                "key": [
                  "if",
                  ["eq", ["get", "p.id"], "other aggregate"],
                  ["list", "slice", "other", "aggregate"],
                  ["list", "slice", ["get", "p.id"]]
                ],
                "x": ["sub", ["get", "cx"], ["get", "radius"]],
                "y": ["sub", ["get", "cy"], ["get", "radius"]],
                "w": ["mul", 2, ["get", "radius"]],
                "h": ["mul", 2, ["get", "radius"]],
                "d": [
                  "wedge",
                  ["point", 0.5, 0.5],
                  ["div", ["get", "inner"], ["mul", 2, ["get", "radius"]]],
                  0.5,
                  ["get", "p.from_"],
                  ["get", "p.to"]
                ],
                "fill": ["get", "p.color"],
                "fillStroke": true
              }
            }
          ]
        },
        {
          "let": [
            [
              "angles",
              [
                "map",
                ["get", "slices"],
                "p",
                {
                  "id": ["get", "p.id"],
                  "color": ["get", "p.color"],
                  "chars": ["concat", ["get", "p.label"], "  ·  ", ["get", "p.percent"]],
                  "angle": ["div", ["add", ["get", "p.from_"], ["get", "p.to"]], 2],
                  "space": [
                    "sector-space",
                    ["get", "midRadius"],
                    ["get", "inner"],
                    ["get", "radius"],
                    ["get", "p.span"]
                  ]
                }
              ]
            ],
            [
              "metrics",
              [
                "map",
                ["get", "angles"],
                "p",
                {
                  "id": ["get", "p.id"],
                  "color": ["get", "p.color"],
                  "chars": ["get", "p.chars"],
                  "size": ["textMetrics", ["get", "p.chars"], ["get", "token.caption"]],
                  "space": ["get", "p.space"],
                  "mid": ["polar", ["get", "center"], ["get", "midRadius"], ["get", "p.angle"]],
                  "rim": ["polar", ["get", "center"], ["get", "radius"], ["get", "p.angle"]],
                  "knee": ["polar", ["get", "center"], ["add", ["get", "radius"], 14], ["get", "p.angle"]]
                }
              ]
            ],
            [
              "inside",
              [
                "map",
                [
                  "filter",
                  ["get", "metrics"],
                  "p",
                  [
                    "lt",
                    ["add", ["hypot", ["div", ["get", "p.size.w"], 2], ["div", ["get", "p.size.h"], 2]], 5],
                    ["get", "p.space"]
                  ]
                ],
                "p",
                {
                  "id": ["get", "p.id"],
                  "chars": ["get", "p.chars"],
                  "color": ["get", "p.color"],
                  "box": {
                    "x": ["sub", ["get", "p.mid.x"], ["add", ["div", ["get", "p.size.w"], 2], 2]],
                    "y": ["sub", ["get", "p.mid.y"], ["add", ["div", ["get", "p.size.h"], 2], 1]],
                    "w": ["add", ["get", "p.size.w"], 4],
                    "h": ["add", ["get", "p.size.h"], 2]
                  }
                }
              ]
            ],
            [
              "outside",
              [
                "map",
                [
                  "filter",
                  ["get", "metrics"],
                  "p",
                  [
                    "if",
                    [
                      "lt",
                      ["add", ["hypot", ["div", ["get", "p.size.w"], 2], ["div", ["get", "p.size.h"], 2]], 5],
                      ["get", "p.space"]
                    ],
                    false,
                    true
                  ]
                ],
                "p",
                {
                  "id": ["get", "p.id"],
                  "chars": ["get", "p.chars"],
                  "rim": ["get", "p.rim"],
                  "knee": ["get", "p.knee"],
                  "isLeft": ["lt", ["get", "p.knee.x"], ["get", "cx"]],
                  "isTop": ["lt", ["get", "p.knee.y"], ["get", "cy"]],
                  "vertical": [
                    "lt",
                    ["max", ["sub", ["get", "cx"], ["get", "p.knee.x"]], ["sub", ["get", "p.knee.x"], ["get", "cx"]]],
                    ["mul", ["get", "radius"], 0.55]
                  ],
                  "box": {
                    "x": [
                      "if",
                      [
                        "lt",
                        [
                          "max",
                          ["sub", ["get", "cx"], ["get", "p.knee.x"]],
                          ["sub", ["get", "p.knee.x"], ["get", "cx"]]
                        ],
                        ["mul", ["get", "radius"], 0.55]
                      ],
                      ["sub", ["get", "p.knee.x"], ["div", ["add", ["get", "p.size.w"], 8], 2]],
                      [
                        "if",
                        ["lt", ["get", "p.knee.x"], ["get", "cx"]],
                        [
                          "sub",
                          ["add", ["get", "cx"], ["mul", -1, ["add", ["get", "radius"], 20]]],
                          ["add", ["get", "p.size.w"], 8]
                        ],
                        ["add", ["get", "cx"], ["mul", 1, ["add", ["get", "radius"], 20]]]
                      ]
                    ],
                    "y": [
                      "if",
                      [
                        "lt",
                        [
                          "max",
                          ["sub", ["get", "cx"], ["get", "p.knee.x"]],
                          ["sub", ["get", "p.knee.x"], ["get", "cx"]]
                        ],
                        ["mul", ["get", "radius"], 0.55]
                      ],
                      [
                        "if",
                        ["lt", ["get", "p.knee.y"], ["get", "cy"]],
                        ["sub", ["get", "p.knee.y"], ["add", ["add", ["get", "p.size.h"], 2], 9]],
                        ["add", ["get", "p.knee.y"], 9]
                      ],
                      [
                        "max",
                        ["get", "titleH"],
                        [
                          "min",
                          ["sub", ["get", "p.knee.y"], ["div", ["add", ["get", "p.size.h"], 2], 2]],
                          [
                            "max",
                            ["get", "titleH"],
                            ["sub", ["sub", ["get", "legendTop"], 10], ["add", ["get", "p.size.h"], 2]]
                          ]
                        ]
                      ]
                    ],
                    "w": ["add", ["get", "p.size.w"], 8],
                    "h": ["add", ["get", "p.size.h"], 2]
                  }
                }
              ]
            ],
            [
              "placed",
              [
                "nonoverlap",
                [
                  "filter",
                  ["get", "outside"],
                  "p",
                  [
                    "if",
                    [
                      "if",
                      ["if", ["lt", ["get", "p.box.x"], 0], false, true],
                      ["if", ["lt", ["get", "frame.w"], ["add", ["get", "p.box.x"], ["get", "p.box.w"]]], false, true],
                      false
                    ],
                    [
                      "if",
                      ["if", ["lt", ["get", "p.box.y"], ["get", "titleH"]], false, true],
                      [
                        "if",
                        ["lt", ["sub", ["get", "legendTop"], 10], ["add", ["get", "p.box.y"], ["get", "p.box.h"]]],
                        false,
                        true
                      ],
                      false
                    ],
                    false
                  ]
                ]
              ]
            ],
            ["placedIds", ["index-by", ["get", "placed"], "id"]]
          ],
          "when": ["get", "variant.labels"],
          "children": [
            {
              "repeat": {
                "over": ["get", "inside"],
                "as": "p"
              },
              "children": [
                {
                  "emit": {
                    "kind": "text",
                    "key": [
                      "if",
                      ["eq", ["get", "p.id"], "other aggregate"],
                      ["list", "percentage", "other", "aggregate"],
                      ["list", "percentage", ["get", "p.id"]]
                    ],
                    "x": ["get", "p.box.x"],
                    "y": ["get", "p.box.y"],
                    "w": ["get", "p.box.w"],
                    "h": ["get", "p.box.h"],
                    "chars": ["get", "p.chars"],
                    "style": ["get", "token.caption"],
                    "color": ["contrast-ink", ["get", "p.color"], ["get", "token.darkInk"], ["get", "token.lightInk"]],
                    "align": "center",
                    "alignV": "center"
                  }
                }
              ]
            },
            {
              "repeat": {
                "over": ["get", "outside"],
                "as": "p"
              },
              "when": ["if", ["eq", ["lookup", ["get", "placedIds"], ["get", "p.id"]], null], false, true],
              "children": [
                {
                  "emit": {
                    "kind": "line",
                    "key": [
                      "if",
                      ["eq", ["get", "p.id"], "other aggregate"],
                      ["list", "leader", "other", "aggregate", "radial"],
                      ["list", "leader", ["get", "p.id"], "radial"]
                    ],
                    "start": ["get", "p.rim"],
                    "end": ["get", "p.knee"],
                    "color": ["get", "token.rule"],
                    "width": 1.5,
                    "route": "straight",
                    "arrow": "none"
                  }
                },
                {
                  "emit": {
                    "kind": "line",
                    "key": [
                      "if",
                      ["eq", ["get", "p.id"], "other aggregate"],
                      ["list", "leader", "other", "aggregate", "end"],
                      ["list", "leader", ["get", "p.id"], "end"]
                    ],
                    "start": ["get", "p.knee"],
                    "end": [
                      "if",
                      ["get", "p.vertical"],
                      [
                        "point",
                        ["add", ["get", "p.box.x"], ["div", ["get", "p.box.w"], 2]],
                        [
                          "if",
                          ["get", "p.isTop"],
                          ["add", ["get", "p.box.y"], ["get", "p.box.h"], 3],
                          ["sub", ["get", "p.box.y"], 3]
                        ]
                      ],
                      [
                        "point",
                        [
                          "if",
                          ["get", "p.isLeft"],
                          ["add", ["get", "p.box.x"], ["get", "p.box.w"], 3],
                          ["sub", ["get", "p.box.x"], 3]
                        ],
                        ["add", ["get", "p.box.y"], ["div", ["get", "p.box.h"], 2]]
                      ]
                    ],
                    "color": ["get", "token.rule"],
                    "width": 1.5,
                    "route": "straight",
                    "arrow": "none"
                  }
                },
                {
                  "emit": {
                    "kind": "text",
                    "key": [
                      "if",
                      ["eq", ["get", "p.id"], "other aggregate"],
                      ["list", "percentage", "other", "aggregate"],
                      ["list", "percentage", ["get", "p.id"]]
                    ],
                    "x": ["get", "p.box.x"],
                    "y": ["get", "p.box.y"],
                    "w": ["get", "p.box.w"],
                    "h": ["get", "p.box.h"],
                    "chars": ["get", "p.chars"],
                    "style": ["get", "token.caption"],
                    "color": ["get", "token.ink"],
                    "align": "center",
                    "alignV": "center"
                  }
                }
              ]
            },
            {
              "repeat": {
                "over": ["get", "outside"],
                "as": "p"
              },
              "children": [
                {
                  "emit": {
                    "kind": "notice",
                    "key": [
                      "if",
                      ["eq", ["get", "p.id"], "other aggregate"],
                      ["list", "percentage", "other", "aggregate"],
                      ["list", "percentage", ["get", "p.id"]]
                    ],
                    "message": "The percentage label could not fit inside or beside its slice."
                  }
                }
              ],
              "when": ["eq", ["lookup", ["get", "placedIds"], ["get", "p.id"]], null]
            }
          ]
        },
        {
          "repeat": {
            "over": ["get", "legend.items"],
            "as": "item"
          },
          "let": [
            ["lx", ["add", 12, ["get", "item.x"]]],
            ["ly", ["add", ["get", "legendTop"], ["mul", ["get", "item.row"], 32]]]
          ],
          "children": [
            {
              "emit": {
                "kind": "rect",
                "key": [
                  "if",
                  ["eq", ["get", "item.item.id"], "other aggregate"],
                  ["list", "swatch", "other", "aggregate"],
                  ["list", "swatch", ["get", "item.item.id"]]
                ],
                "x": ["get", "lx"],
                "y": ["add", ["get", "ly"], 10],
                "w": 12,
                "h": 12,
                "fill": ["get", "item.item.color"]
              }
            },
            {
              "emit": {
                "kind": "text",
                "key": [
                  "if",
                  ["eq", ["get", "item.item.id"], "other aggregate"],
                  ["list", "legend", "other", "aggregate"],
                  ["list", "legend", ["get", "item.item.id"]]
                ],
                "x": ["add", ["get", "lx"], 22],
                "y": ["get", "ly"],
                "w": ["get", "item.w"],
                "h": 32,
                "chars": ["get", "item.item.chars"],
                "size": ["get", "legend.size"],
                "style": ["get", "token.caption"],
                "color": ["get", "token.ink"],
                "align": "left",
                "alignV": "center"
              }
            }
          ]
        },
        {
          "repeat": {
            "over": ["get", "rows"],
            "as": "r"
          },
          "children": [
            {
              "emit": {
                "kind": "notice",
                "key": [
                  "if",
                  ["eq", ["get", "r.id"], "other aggregate"],
                  ["list", "slice", "other", "aggregate"],
                  ["list", "slice", ["get", "r.id"]]
                ],
                "message": "This slice is too small to draw at the current precision."
              },
              "when": [
                "if",
                ["lt", 0, ["get", "r.value"]],
                ["if", ["lt", 1e-6, ["div", ["get", "r.value"], ["get", "total"]]], false, true],
                false
              ]
            }
          ]
        }
      ]
    }
  ]
}
