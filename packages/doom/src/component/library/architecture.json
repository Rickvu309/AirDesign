{
  "version": 1,
  "name": "Architecture",
  "collections": {
    "layers": {
      "label": "string"
    },
    "components": {
      "layer": "ref:layers",
      "name": "string"
    },
    "links": {
      "from": "ref:components",
      "to": "ref:components"
    }
  },
  "defaults": {
    "ink": {
      "var": "text"
    },
    "muted": {
      "var": "text2"
    },
    "band": {
      "var": "background2"
    },
    "card": {
      "var": "background"
    },
    "edge": {
      "var": "text2",
      "tint": 0.7
    },
    "connector": {
      "var": "text2"
    },
    "label": "label",
    "labelSmall": 20,
    "layerLabel": "label",
    "layerSmall": 20,
    "radius": 8,
    "lineWidth": 3
  },
  "let": [
    ["layerGap", 48],
    ["inset", 24],
    ["gutter", 96],
    ["labelW", ["min", 240, ["mul", ["get", "frame.w"], 0.2]]],
    ["cardGap", 32],
    ["layerCount", ["count", ["get", "data.layers"]]],
    [
      "columns",
      [
        "max",
        1,
        [
          "map",
          ["get", "data.layers"],
          "l",
          ["count", ["filter", ["get", "data.components"], "c", ["eq", ["get", "c.layer"], ["get", "l.id"]]]]
        ]
      ]
    ],
    ["contentX", ["get", "labelW"]],
    ["contentW", ["max", 0, ["sub", ["sub", ["get", "frame.w"], ["get", "labelW"]], ["get", "gutter"]]]],
    [
      "cardW",
      [
        "min",
        320,
        [
          "div",
          ["max", 0, ["sub", ["get", "contentW"], ["mul", ["get", "cardGap"], ["sub", ["get", "columns"], 1]]]],
          ["get", "columns"]
        ]
      ]
    ],
    [
      "bandH",
      [
        "div",
        [
          "max",
          0,
          ["sub", ["get", "frame.h"], ["mul", ["get", "layerGap"], ["max", 0, ["sub", ["get", "layerCount"], 1]]]]
        ],
        ["max", 1, ["get", "layerCount"]]
      ]
    ],
    ["bandStep", ["add", ["get", "bandH"], ["get", "layerGap"]]],
    ["cardH", ["max", 0, ["min", 88, ["sub", ["get", "bandH"], 32]]]],
    [
      "indexed",
      [
        "map",
        ["get", "data.components"],
        "c",
        {
          "id": ["get", "c.id"],
          "layer": ["get", "c.layer"],
          "at": ["get", "i"],
          "name": ["get", "c.name"]
        }
      ]
    ],
    [
      "placed",
      [
        "map",
        ["get", "indexed"],
        "c",
        {
          "id": ["get", "c.id"],
          "layer": [
            "sum",
            ["map", ["get", "data.layers"], "l", ["if", ["eq", ["get", "l.id"], ["get", "c.layer"]], ["get", "i"], 0]]
          ],
          "slot": [
            "count",
            [
              "filter",
              ["get", "indexed"],
              "o",
              ["if", ["eq", ["get", "o.layer"], ["get", "c.layer"]], ["lt", ["get", "o.at"], ["get", "c.at"]], false]
            ]
          ],
          "name": ["get", "c.name"]
        }
      ]
    ],
    [
      "cards",
      [
        "map",
        ["get", "placed"],
        "p",
        {
          "id": ["get", "p.id"],
          "row": ["get", "p.layer"],
          "x": [
            "add",
            ["get", "contentX"],
            [
              "div",
              [
                "sub",
                ["get", "contentW"],
                [
                  "sub",
                  [
                    "mul",
                    ["count", ["filter", ["get", "placed"], "q", ["eq", ["get", "p.layer"], ["get", "q.layer"]]]],
                    ["add", ["get", "cardW"], ["get", "cardGap"]]
                  ],
                  ["get", "cardGap"]
                ]
              ],
              2
            ],
            ["mul", ["get", "p.slot"], ["add", ["get", "cardW"], ["get", "cardGap"]]]
          ],
          "y": [
            "add",
            ["mul", ["get", "p.layer"], ["get", "bandStep"]],
            ["div", ["sub", ["get", "bandH"], ["get", "cardH"]], 2]
          ],
          "w": ["get", "cardW"],
          "h": ["get", "cardH"],
          "name": ["get", "p.name"]
        }
      ]
    ],
    [
      "routes",
      [
        "link-channels",
        ["get", "cards"],
        ["get", "data.links"],
        {
          "left": ["sub", ["get", "labelW"], ["get", "inset"]],
          "right": ["sub", ["get", "frame.w"], 12],
          "bottom": ["get", "frame.h"]
        }
      ]
    ]
  ],
  "parts": [
    {
      "repeat": {
        "over": ["get", "data.layers"],
        "as": "l"
      },
      "let": [
        ["bandY", ["mul", ["get", "i"], ["get", "bandStep"]]],
        ["row", ["get", "i"]],
        ["members", ["filter", ["get", "cards"], "c", ["eq", ["get", "c.row"], ["get", "row"]]]]
      ],
      "children": [
        {
          "emit": {
            "kind": "rect",
            "key": ["list", "band", ["get", "l.id"]],
            "x": 0,
            "y": ["get", "bandY"],
            "w": ["get", "frame.w"],
            "h": ["get", "bandH"],
            "fill": ["get", "token.band"],
            "radius": ["get", "token.radius"]
          }
        },
        {
          "emit": {
            "kind": "text",
            "key": ["list", "layer", ["get", "l.id"]],
            "x": ["get", "inset"],
            "y": ["get", "bandY"],
            "w": ["max", 0, ["sub", ["get", "labelW"], ["mul", 2, ["get", "inset"]]]],
            "h": ["get", "bandH"],
            "chars": ["get", "l.label"],
            "style": ["get", "token.layerLabel"],
            "color": ["get", "token.muted"],
            "align": "left",
            "alignV": "center",
            "fit": {
              "smaller": ["get", "token.layerSmall"],
              "group": "layers"
            }
          }
        },
        {
          "repeat": {
            "over": ["get", "members"],
            "as": "c"
          },
          "emit": {
            "kind": "text",
            "key": ["list", "component", ["get", "c.id"]],
            "x": ["get", "c.x"],
            "y": ["get", "c.y"],
            "w": ["get", "c.w"],
            "h": ["get", "c.h"],
            "chars": ["get", "c.name"],
            "style": ["get", "token.label"],
            "color": ["get", "token.ink"],
            "align": "center",
            "alignV": "center",
            "fill": ["get", "token.card"],
            "overflow": "ellipsis",
            "stroke": {
              "color": ["get", "token.edge"],
              "width": 2
            },
            "radius": ["get", "token.radius"],
            "padding": 16,
            "fit": {
              "smaller": ["get", "token.labelSmall"],
              "group": "components"
            }
          }
        }
      ]
    },
    {
      "repeat": {
        "over": ["get", "data.links"],
        "as": "k"
      },
      "let": [["path", ["at", ["get", "routes"], ["get", "i"]]]],
      "emit": {
        "kind": "line",
        "key": ["list", "link", ["get", "k.id"]],
        "start": {
          "key": ["list", "component", ["get", "k.from"]],
          "site": ["get", "path.start.site"],
          "along": ["get", "path.start.along"]
        },
        "end": {
          "key": ["list", "component", ["get", "k.to"]],
          "site": ["get", "path.end.site"],
          "along": ["get", "path.end.along"]
        },
        "color": ["get", "token.connector"],
        "width": ["get", "token.lineWidth"],
        "route": "elbow",
        "arrow": "triangle",
        "channels": ["get", "path.channels"]
      }
    }
  ]
}
