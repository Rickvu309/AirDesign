{
  "version": 1,
  "name": "Stacked column",
  "chart": "cartesian",
  "minFrame": { "w": 160, "h": 180 },
  "sample": {
    "w": 1540,
    "h": 650,
    "data": {
      "categories": [
        {
          "id": "c1",
          "label": "Q1"
        },
        {
          "id": "c2",
          "label": "Q2"
        },
        {
          "id": "c3",
          "label": "Q3"
        },
        {
          "id": "c4",
          "label": "Q4"
        }
      ],
      "series": [
        {
          "id": "existing",
          "label": "Existing"
        },
        {
          "id": "new",
          "label": "New"
        }
      ],
      "segments": [
        {
          "id": "1-existing",
          "category": "c1",
          "series": "existing",
          "value": 12
        },
        {
          "id": "1-new",
          "category": "c1",
          "series": "new",
          "value": 8
        },
        {
          "id": "2-existing",
          "category": "c2",
          "series": "existing",
          "value": 14
        },
        {
          "id": "2-new",
          "category": "c2",
          "series": "new",
          "value": 9
        },
        {
          "id": "3-existing",
          "category": "c3",
          "series": "existing",
          "value": 16
        },
        {
          "id": "3-new",
          "category": "c3",
          "series": "new",
          "value": 9
        },
        {
          "id": "4-existing",
          "category": "c4",
          "series": "existing",
          "value": 18
        },
        {
          "id": "4-new",
          "category": "c4",
          "series": "new",
          "value": 10
        }
      ]
    }
  },
  "collections": {
    "categories": {
      "label": "string"
    },
    "series": {
      "label": "string",
      "color": "color?"
    },
    "segments": {
      "category": "ref:categories",
      "series": "ref:series",
      "value": "number",
      "color": "color?"
    }
  },
  "variants": {
    "labels": [true, false],
    "totals": [true, false],
    "legend": [true, false]
  },
  "defaultVariant": {
    "labels": true,
    "totals": true,
    "legend": false
  },
  "defaults": {
    "scale": 1,
    "digits": "auto",
    "prefix": "",
    "suffix": "",
    "unitHeader": "",
    "unitPlace": "header",
    "title": "",
    "ink": {
      "var": "text"
    },
    "muted": {
      "var": "text2"
    },
    "rule": {
      "var": "text2"
    },
    "heading": "label",
    "label": "label",
    "caption": "caption",
    "captionSmall": 18,
    "accent1": {
      "var": "accent1"
    },
    "neutral": {
      "var": "text2"
    },
    "source": "",
    "valueWidth": 24,
    "totalWidth": 48
  },
  "let": [
    ["multipleSeries", ["lt", 1, ["count", ["get", "data.series"]]]],
    ["headerUnit", ["if", ["eq", ["get", "token.unitPlace"], "header"], ["get", "token.unitHeader"], ""]],
    ["gutter", ["min", 12, ["div", ["get", "frame.w"], 4]]],
    ["rowCount", ["count", ["get", "data.categories"]]],
    ["availableWidth", ["sub", ["get", "frame.w"], ["mul", 2, ["get", "gutter"]]]],
    ["categoryTop", ["max", 0, ["sub", ["get", "frame.h"], ["if", ["eq", ["get", "token.source"], ""], 56, 98]]]],
    ["plotBottom", ["max", 0, ["sub", ["get", "categoryTop"], 10]]],
    [
      "plotTop",
      [
        "min",
        ["div", ["get", "plotBottom"], 2],
        [
          "if",
          ["get", "multipleSeries"],
          [
            "if",
            ["if", ["eq", ["get", "token.title"], ""], false, ["if", ["eq", ["get", "headerUnit"], ""], false, true]],
            164,
            130
          ],
          ["if", ["get", "variant.totals"], 92, 66]
        ]
      ]
    ],
    [
      "fold",
      [
        "rampFold",
        ["get", "data.series"],
        ["matchingFocus", ["get", "focus"], ["get", "data.series"], "id"],
        {
          "id": "other aggregate",
          "label": "Other",
          "color": null
        }
      ]
    ],
    [
      "seriesItems",
      [
        "map",
        ["get", "fold.rows"],
        "s",
        {
          "id": ["get", "s.id"],
          "order": ["get", "i"],
          "fill": [
            "if",
            ["eq", ["get", "s.color"], null],
            [
              "paletteRamp",
              ["at", ["get", "fold.slots"], ["get", "i"]],
              ["get", "fold.count"],
              ["get", "token.accent1"],
              ["get", "token.neutral"]
            ],
            ["get", "s.color"]
          ],
          "chars": ["get", "s.label"]
        }
      ]
    ],
    ["seriesColors", ["groupBy", ["get", "seriesItems"], "id"]],
    [
      "segmentsByCategory",
      [
        "groupBy",
        [
          "if",
          ["get", "multipleSeries"],
          [
            "sortBy",
            [
              "map",
              [
                "filter",
                ["get", "data.segments"],
                "s",
                ["if", ["includes", ["get", "fold.folded"], ["get", "s.series"]], false, true]
              ],
              "s",
              {
                "id": ["get", "s.id"],
                "category": ["get", "s.category"],
                "series": ["get", "s.series"],
                "value": ["get", "s.value"],
                "color": ["get", "s.color"],
                "order": ["lookup", ["at", ["lookup", ["get", "seriesColors"], ["get", "s.series"]], 0], "order"]
              }
            ],
            "order"
          ],
          ["get", "data.segments"]
        ],
        "category"
      ]
    ],
    [
      "groups",
      [
        "map",
        ["get", "data.categories"],
        "c",
        {
          "id": ["get", "c.id"],
          "label": ["get", "c.label"],
          "segments": [
            "flatten",
            [
              "list",
              ["lookup", ["get", "segmentsByCategory"], ["get", "c.id"], ["list"]],
              [
                "if",
                ["lt", 0, ["count", ["get", "fold.folded"]]],
                [
                  "list",
                  {
                    "id": "other aggregate",
                    "category": ["get", "c.id"],
                    "series": "other aggregate",
                    "value": [
                      "sum",
                      [
                        "map",
                        [
                          "filter",
                          ["get", "data.segments"],
                          "s",
                          [
                            "if",
                            ["eq", ["get", "s.category"], ["get", "c.id"]],
                            ["includes", ["get", "fold.folded"], ["get", "s.series"]],
                            false
                          ]
                        ],
                        "s",
                        ["get", "s.value"]
                      ]
                    ],
                    "color": null
                  }
                ],
                ["list"]
              ]
            ]
          ]
        }
      ]
    ],
    [
      "lo",
      [
        "min",
        0,
        [
          "map",
          ["get", "groups"],
          "group",
          ["sum", ["map", ["get", "group.segments"], "s", ["min", 0, ["get", "s.value"]]]]
        ]
      ]
    ],
    [
      "upper",
      [
        "max",
        0,
        [
          "map",
          ["get", "groups"],
          "group",
          ["sum", ["map", ["get", "group.segments"], "s", ["max", 0, ["get", "s.value"]]]]
        ]
      ]
    ],
    ["hi", ["if", ["eq", ["get", "upper"], ["get", "lo"]], 1, ["get", "upper"]]],
    [
      "lastGroup",
      [
        "if",
        [
          "if",
          ["get", "multipleSeries"],
          ["if", ["lt", ["count", ["get", "fold.rows"]], 6], ["eq", ["get", "variant.legend"], false], false],
          false
        ],
        ["at", ["get", "groups"], ["sub", ["get", "rowCount"], 1]],
        null
      ]
    ],
    [
      "eligible",
      [
        "if",
        ["eq", ["get", "lastGroup"], null],
        ["list"],
        [
          "filter",
          ["get", "lastGroup.segments"],
          "s",
          [
            "lt",
            38,
            [
              "mul",
              ["max", ["get", "s.value"], ["sub", 0, ["get", "s.value"]]],
              ["div", ["sub", ["get", "plotBottom"], ["get", "plotTop"]], ["sub", ["get", "hi"], ["get", "lo"]]]
            ]
          ]
        ]
      ]
    ],
    ["lastBySeries", ["groupBy", ["get", "eligible"], "series"]],
    [
      "directLabels",
      [
        "filter",
        ["get", "seriesItems"],
        "s",
        [
          "if",
          ["eq", ["get", "s.chars"], ""],
          false,
          ["if", ["eq", ["lookup", ["get", "lastBySeries"], ["get", "s.id"]], null], false, true]
        ]
      ]
    ],
    [
      "directWidth",
      [
        "if",
        [
          "if",
          ["get", "multipleSeries"],
          [
            "if",
            ["eq", ["count", ["get", "eligible"]], ["count", ["get", "fold.rows"]]],
            [
              "if",
              ["eq", ["count", ["get", "lastGroup.segments"]], ["count", ["get", "fold.rows"]]],
              ["eq", ["count", ["get", "directLabels"]], ["count", ["get", "fold.rows"]]],
              false
            ],
            false
          ],
          false
        ],
        [
          "add",
          18,
          ["max", 0, ["map", ["get", "directLabels"], "s", ["textWidth", ["get", "s.chars"], ["get", "token.caption"]]]]
        ],
        0
      ]
    ],
    [
      "direct",
      [
        "if",
        ["lt", 0, ["get", "directWidth"]],
        ["lt", ["get", "directWidth"], ["mul", 0.3, ["get", "availableWidth"]]],
        false
      ]
    ],
    ["plotWidth", ["sub", ["get", "availableWidth"], ["if", ["get", "direct"], ["get", "directWidth"], 0]]],
    [
      "density",
      [
        "if",
        ["lt", 5, ["max", 0, ["map", ["get", "groups"], "c", ["count", ["get", "c.segments"]]]]],
        ["advise", "many-segments", "Group smaller segments as Other to keep each column to five segments."],
        false
      ]
    ],
    ["zero", ["linear", 0, ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]],
    [
      "digits",
      [
        "if",
        ["eq", ["get", "token.digits"], "auto"],
        ["decimals", ["map", ["get", "data.segments"], "s", ["get", "s.value"]], ["get", "token.scale"]],
        ["get", "token.digits"]
      ]
    ],
    [
      "valueFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": ["get", "digits"],
        "prefix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.prefix"], ""],
        "suffix": ["if", ["eq", ["get", "token.unitPlace"], "label"], ["get", "token.suffix"], ""],
        "sign": "negative"
      }
    ],
    [
      "legendTop",
      [
        "if",
        ["eq", ["get", "token.title"], ""],
        ["if", ["eq", ["get", "headerUnit"], ""], 44, 38],
        ["if", ["eq", ["get", "headerUnit"], ""], 46, 78]
      ]
    ],
    [
      "legendHeight",
      [
        "min",
        38,
        [
          "max",
          0,
          ["sub", ["sub", ["get", "plotTop"], ["get", "legendTop"]], ["if", ["get", "variant.totals"], 45, 16]]
        ]
      ]
    ],
    ["chip", ["min", 18, ["get", "legendHeight"]]],
    [
      "legend",
      [
        "if",
        ["if", ["get", "multipleSeries"], ["eq", ["get", "direct"], false], false],
        [
          "flowText",
          ["get", "seriesItems"],
          {
            "width": ["get", "plotWidth"],
            "rows": 1,
            "rowHeight": ["get", "legendHeight"],
            "leading": ["add", ["get", "chip"], 8],
            "gap": 22,
            "style": ["get", "token.caption"],
            "smaller": ["get", "token.captionSmall"]
          }
        ],
        {
          "items": ["list"]
        }
      ]
    ],
    [
      "labelSpace",
      {
        "lane": ["div", ["get", "plotWidth"], ["max", 1, ["get", "rowCount"]]]
      }
    ]
  ],
  "parts": [
    {
      "when": ["if", ["eq", ["get", "token.title"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "title"],
        "x": ["get", "gutter"],
        "y": 0,
        "w": ["get", "availableWidth"],
        "h": 38,
        "chars": ["get", "token.title"],
        "style": ["get", "token.heading"],
        "color": ["get", "token.ink"],
        "align": "left",
        "alignV": "center",
        "fit": "omit"
      }
    },
    {
      "when": ["if", ["eq", ["get", "headerUnit"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "unit"],
        "x": ["get", "gutter"],
        "y": ["if", ["eq", ["get", "token.title"], ""], 0, 36],
        "w": ["get", "availableWidth"],
        "h": 38,
        "chars": ["get", "headerUnit"],
        "style": ["get", "token.caption"],
        "color": ["get", "token.muted"],
        "align": "left",
        "alignV": "center",
        "fit": "omit"
      }
    },
    {
      "when": ["if", ["eq", ["get", "token.source"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "source"],
        "x": ["get", "gutter"],
        "y": ["max", 0, ["sub", ["get", "frame.h"], 38]],
        "w": ["get", "availableWidth"],
        "h": 38,
        "chars": ["get", "token.source"],
        "style": ["get", "token.caption"],
        "color": ["get", "token.muted"],
        "align": "left",
        "alignV": "center",
        "fit": "omit"
      }
    },
    {
      "repeat": {
        "over": ["get", "legend.items"],
        "as": "placed"
      },
      "let": [["legendLeft", ["add", ["get", "gutter"], ["get", "placed.x"]]]],
      "children": [
        {
          "emit": {
            "kind": "rect",
            "key": [
              "if",
              ["eq", ["get", "placed.item.id"], "other aggregate"],
              ["list", "legend-swatch", "other", "aggregate"],
              ["list", "legend-swatch", ["get", "placed.item.id"]]
            ],
            "x": ["get", "legendLeft"],
            "y": ["add", ["get", "legendTop"], ["div", ["sub", ["get", "legendHeight"], ["get", "chip"]], 2]],
            "w": ["get", "chip"],
            "h": ["get", "chip"],
            "fill": ["get", "placed.item.fill"]
          }
        },
        {
          "emit": {
            "kind": "text",
            "key": [
              "if",
              ["eq", ["get", "placed.item.id"], "other aggregate"],
              ["list", "legend-label", "other", "aggregate"],
              ["list", "legend-label", ["get", "placed.item.id"]]
            ],
            "x": ["add", ["get", "legendLeft"], ["add", ["get", "chip"], 8]],
            "y": ["get", "legendTop"],
            "w": ["get", "placed.w"],
            "h": ["get", "legendHeight"],
            "chars": ["get", "placed.item.chars"],
            "style": ["get", "token.caption"],
            "size": ["get", "legend.size"],
            "color": ["get", "token.muted"],
            "align": "left",
            "alignV": "center"
          }
        }
      ]
    },
    {
      "emit": {
        "kind": "line",
        "key": ["list", "zero"],
        "start": ["point", ["get", "gutter"], ["get", "zero"]],
        "end": ["point", ["add", ["get", "gutter"], ["get", "plotWidth"]], ["get", "zero"]],
        "color": ["get", "token.rule"],
        "width": 2,
        "route": "straight",
        "arrow": "none"
      }
    },
    {
      "repeat": {
        "over": ["get", "groups"],
        "as": "group"
      },
      "let": [
        ["lane", ["band", ["get", "i"], ["get", "rowCount"], ["get", "gutter"], ["get", "plotWidth"], 1]],
        ["mark", ["band", ["get", "i"], ["get", "rowCount"], ["get", "gutter"], ["get", "plotWidth"], 0.57]],
        [
          "stack",
          [
            "scan",
            ["get", "group.segments"],
            "s",
            {
              "positive": 0,
              "negative": 0,
              "up": 0,
              "down": 0
            },
            {
              "positive": ["add", ["get", "acc.positive"], ["max", 0, ["get", "s.value"]]],
              "negative": ["add", ["get", "acc.negative"], ["min", 0, ["get", "s.value"]]],
              "up": ["if", ["lt", 0, ["get", "s.value"]], ["get", "s.value"], ["get", "acc.up"]],
              "down": ["if", ["lt", ["get", "s.value"], 0], ["sub", 0, ["get", "s.value"]], ["get", "acc.down"]]
            },
            {
              "id": ["get", "s.id"],
              "value": ["get", "s.value"],
              "start": ["if", ["lt", ["get", "s.value"], 0], ["get", "acc.negative"], ["get", "acc.positive"]],
              "end": ["if", ["lt", ["get", "s.value"], 0], ["get", "next.negative"], ["get", "next.positive"]],
              "below": ["if", ["lt", ["get", "s.value"], 0], ["get", "acc.down"], ["get", "acc.up"]],
              "series": ["get", "s.series"],
              "color": ["get", "s.color"]
            }
          ]
        ],
        ["narrowValues", ["lt", ["sub", ["mul", ["get", "labelSpace.lane"], 0.57], 8], ["get", "token.valueWidth"]]],
        ["narrowTotals", ["lt", ["get", "labelSpace.lane"], ["get", "token.totalWidth"]]]
      ],
      "children": [
        {
          "repeat": {
            "over": ["get", "stack"],
            "as": "s"
          },
          "when": ["if", ["eq", ["get", "s.value"], 0], false, true],
          "let": [
            [
              "a",
              ["linear", ["get", "s.start"], ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]
            ],
            [
              "b",
              ["linear", ["get", "s.end"], ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]
            ],
            ["top", ["min", ["get", "a"], ["get", "b"]]],
            ["height", ["sub", ["max", ["get", "a"], ["get", "b"]], ["get", "top"]]],
            [
              "seam",
              [
                "if",
                [
                  "lt",
                  [
                    "min",
                    ["get", "height"],
                    [
                      "mul",
                      ["get", "s.below"],
                      ["div", ["sub", ["get", "plotBottom"], ["get", "plotTop"]], ["sub", ["get", "hi"], ["get", "lo"]]]
                    ]
                  ],
                  4
                ],
                0,
                2
              ]
            ],
            ["seriesPaint", ["at", ["lookup", ["get", "seriesColors"], ["get", "s.series"]], 0]],
            ["fill", ["if", ["eq", ["get", "s.color"], null], ["get", "seriesPaint.fill"], ["get", "s.color"]]]
          ],
          "children": [
            {
              "emit": {
                "kind": "rect",
                "key": [
                  "if",
                  ["eq", ["get", "s.id"], "other aggregate"],
                  ["list", "segment", ["get", "group.id"], "other", "aggregate"],
                  ["list", "segment", ["get", "group.id"], ["get", "s.id"]]
                ],
                "x": ["get", "mark.start"],
                "y": [
                  "if",
                  ["lt", ["get", "a"], ["get", "b"]],
                  ["add", ["get", "top"], ["get", "seam"]],
                  ["get", "top"]
                ],
                "w": ["get", "mark.size"],
                "h": ["max", 1, ["sub", ["get", "height"], ["get", "seam"]]],
                "fill": ["get", "fill"]
              }
            },
            {
              "when": ["if", ["get", "narrowValues"], false, ["get", "variant.labels"]],
              "emit": {
                "kind": "text",
                "key": [
                  "if",
                  ["eq", ["get", "s.id"], "other aggregate"],
                  ["list", "value", ["get", "group.id"], "other", "aggregate"],
                  ["list", "value", ["get", "group.id"], ["get", "s.id"]]
                ],
                "x": ["add", ["get", "mark.start"], ["min", 4, ["div", ["get", "mark.size"], 2]]],
                "y": ["get", "top"],
                "w": ["max", 0, ["sub", ["get", "mark.size"], 8]],
                "h": ["get", "height"],
                "chars": ["format", ["get", "s.value"], ["get", "valueFormat"]],
                "style": ["get", "token.label"],
                "color": ["readableInk", ["get", "fill"]],
                "align": "center",
                "alignV": "center",
                "fit": {
                  "minWidth": ["get", "token.valueWidth"]
                }
              }
            },
            {
              "when": ["if", ["get", "direct"], ["eq", ["get", "group.id"], ["get", "lastGroup.id"]], false],
              "emit": {
                "kind": "text",
                "key": [
                  "if",
                  ["eq", ["get", "s.series"], "other aggregate"],
                  ["list", "series-label", "other", "aggregate"],
                  ["list", "series-label", ["get", "s.series"]]
                ],
                "x": ["add", ["add", ["get", "mark.start"], ["get", "mark.size"]], 12],
                "y": ["get", "top"],
                "w": ["sub", ["get", "directWidth"], 10],
                "h": ["get", "height"],
                "chars": ["get", "seriesPaint.chars"],
                "style": ["get", "token.caption"],
                "color": ["get", "token.ink"],
                "align": "left",
                "alignV": "center",
                "fit": "omit"
              }
            }
          ]
        },
        {
          "when": ["if", ["get", "narrowTotals"], false, ["get", "variant.totals"]],
          "let": [
            ["positive", ["sum", ["map", ["get", "group.segments"], "s", ["max", 0, ["get", "s.value"]]]]],
            [
              "top",
              ["linear", ["get", "positive"], ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]
            ],
            ["net", ["sum", ["map", ["get", "group.segments"], "s", ["get", "s.value"]]]],
            [
              "prefix",
              [
                "if",
                ["if", ["lt", 0, ["get", "positive"]], ["lt", ["get", "net"], ["get", "positive"]], false],
                "Net ",
                ""
              ]
            ]
          ],
          "emit": {
            "kind": "text",
            "key": ["list", "total", ["get", "group.id"]],
            "x": ["get", "lane.start"],
            "y": ["sub", ["get", "top"], 37],
            "w": ["get", "lane.size"],
            "h": 32,
            "chars": ["concat", ["get", "prefix"], ["format", ["get", "net"], ["get", "valueFormat"]]],
            "style": ["get", "token.label"],
            "color": ["get", "token.ink"],
            "align": "center",
            "alignV": "center",
            "fit": {
              "minWidth": ["get", "token.totalWidth"]
            }
          }
        },
        {
          "emit": {
            "kind": "text",
            "key": ["list", "category", ["get", "group.id"]],
            "x": ["get", "lane.start"],
            "y": ["get", "categoryTop"],
            "w": ["get", "lane.size"],
            "h": 56,
            "chars": ["get", "group.label"],
            "style": ["get", "token.caption"],
            "color": ["get", "token.muted"],
            "align": "center",
            "alignV": "center",
            "fit": {
              "smaller": ["get", "token.captionSmall"],
              "group": "categories",
              "thin": 4,
