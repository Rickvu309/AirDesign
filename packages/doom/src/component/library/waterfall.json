{
  "version": 1,
  "name": "Waterfall",
  "collections": {
    "rows": {
      "label": "string",
      "value": "number",
      "mode": ["delta", "total"],
      "after": ["carry", "reset"]
    }
  },
  "variants": {
    "labels": [true, false],
    "signed": [true, false]
  },
  "defaultVariant": {
    "labels": true,
    "signed": false
  },
  "defaults": {
    "scale": 1,
    "digits": "auto",
    "unitHeader": "",
    "title": "",
    "ink": {
      "var": "text"
    },
    "muted": {
      "var": "text2"
    },
    "rule": {
      "var": "text2"
    },
    "heading": "label",
    "label": "label",
    "caption": "caption",
    "captionSmall": 18,
    "up": {
      "var": "positive"
    },
    "down": {
      "var": "negative"
    },
    "total": {
      "var": "total"
    },
    "neutral": {
      "var": "text2"
    },
    "highlight": { "var": "accent1" },
    "source": ""
  },
  "let": [
    ["headerUnit", ["get", "token.unitHeader"]],
    ["gutter", ["min", 12, ["div", ["get", "frame.w"], 4]]],
    ["rowCount", ["count", ["get", "data.rows"]]],
    ["lastMode", ["at", ["map", ["get", "data.rows"], "r", ["get", "r.mode"]], ["sub", ["get", "rowCount"], 1]]],
    ["availableWidth", ["sub", ["get", "frame.w"], ["mul", 2, ["get", "gutter"]]]],
    ["plotWidth", ["get", "availableWidth"]],
    ["categoryTop", ["max", 0, ["sub", ["get", "frame.h"], ["if", ["eq", ["get", "token.source"], ""], 56, 98]]]],
    ["plotBottom", ["max", 0, ["sub", ["get", "categoryTop"], 12]]],
    ["plotTop", ["min", ["div", ["get", "plotBottom"], 2], ["if", ["get", "variant.labels"], 90, 60]]],
    [
      "steps",
      [
        "scan",
        ["get", "data.rows"],
        "r",
        0,
        [
          "if",
          ["eq", ["get", "r.after"], "reset"],
          0,
          [
            "if",
            ["eq", ["get", "i"], 0],
            ["get", "r.value"],
            ["if", ["eq", ["get", "r.mode"], "total"], ["get", "acc"], ["add", ["get", "acc"], ["get", "r.value"]]]
          ]
        ],
        {
          "id": ["get", "r.id"],
          "label": ["get", "r.label"],
          "mode": ["get", "r.mode"],
          "after": ["get", "r.after"],
          "start": ["if", ["eq", ["get", "r.mode"], "total"], 0, ["get", "acc"]],
          "end": [
            "if",
            ["eq", ["get", "i"], 0],
            ["get", "r.value"],
            ["if", ["eq", ["get", "r.mode"], "total"], ["get", "acc"], ["add", ["get", "acc"], ["get", "r.value"]]]
          ],
          "value": [
            "if",
            ["eq", ["get", "i"], 0],
            ["get", "r.value"],
            ["if", ["eq", ["get", "r.mode"], "total"], ["get", "acc"], ["get", "r.value"]]
          ],
          "given": ["get", "r.value"]
        }
      ]
    ],
    ["starts", ["map", ["get", "steps"], "r", ["get", "r.start"]]],
    ["ends", ["map", ["get", "steps"], "r", ["get", "r.end"]]],
    ["lo", ["min", 0, ["get", "starts"], ["get", "ends"]]],
    ["upper", ["max", 0, ["get", "starts"], ["get", "ends"]]],
    ["hi", ["if", ["eq", ["get", "upper"], ["get", "lo"]], 1, ["get", "upper"]]],
    ["zero", ["linear", 0, ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]],
    [
      "digits",
      [
        "if",
        ["eq", ["get", "token.digits"], "auto"],
        ["decimals", ["map", ["get", "steps"], "r", ["get", "r.value"]], ["get", "token.scale"]],
        ["get", "token.digits"]
      ]
    ],
    [
      "stepDensity",
      [
        "if",
        ["lt", 8, ["count", ["filter", ["get", "steps"], "r", ["eq", ["get", "r.mode"], "delta"]]]],
        ["advise", "many-steps", "Group small steps as Other to keep the main drivers readable."],
        false
      ]
    ],
    [
      "deltaFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": ["get", "digits"],
        "prefix": "",
        "suffix": "",
        "sign": "always"
      }
    ],
    [
      "totalFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": ["get", "digits"],
        "prefix": "",
        "suffix": "",
        "sign": "negative"
      }
    ],
    [
      "activeFocus",
      [
        "matchingFocus",
        ["get", "focus"],
        ["filter", ["get", "data.rows"], "r", ["if", ["eq", ["get", "r.mode"], "total"], false, true]],
        "id"
      ]
    ],
    ["neutralFill", ["paletteRamp", 1, 2, ["get", "token.highlight"], ["get", "token.neutral"], true]],
    [
      "totalFill",
      [
        "if",
        ["get", "variant.signed"],
        ["get", "token.total"],
        ["contrastGrey", { "var": "background" }, { "var": "accent1" }, ["get", "neutralFill"], 5, 1.5]
      ]
    ],
    [
      "closingAdvice",
      [
        "if",
        ["lt", 0, ["get", "rowCount"]],
        [
          "if",
          ["eq", ["get", "lastMode"], "delta"],
          ["advise", "missing-closing-total", "Add a closing total row."],
          false
        ],
        false
      ]
    ],
    ["valueWidth", 24],
    ["narrowValues", ["lt", ["div", ["get", "plotWidth"], ["max", 1, ["get", "rowCount"]]], ["get", "valueWidth"]]],
    [
      "labelAdvice",
      [
        "if",
        ["if", ["get", "variant.labels"], ["get", "narrowValues"], false],
        ["advise", "labels-omitted", "Widen the chart or show fewer columns to fit value labels."],
        false
      ]
    ]
  ],
  "parts": [
    {
      "when": ["if", ["eq", ["get", "token.title"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "title"],
        "x": ["get", "gutter"],
        "y": 0,
        "w": ["get", "availableWidth"],
        "h": 38,
        "chars": ["get", "token.title"],
        "style": ["get", "token.heading"],
        "color": ["get", "token.ink"],
        "align": "left",
        "alignV": "center",
        "fit": "omit"
      }
    },
    {
      "when": ["if", ["eq", ["get", "headerUnit"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "unit"],
        "x": ["get", "gutter"],
        "y": ["if", ["eq", ["get", "token.title"], ""], 0, 36],
        "w": ["get", "availableWidth"],
        "h": 38,
        "chars": ["get", "headerUnit"],
        "style": ["get", "token.caption"],
        "color": ["get", "token.muted"],
        "align": "left",
        "alignV": "center",
        "fit": "omit"
      }
    },
    {
      "when": ["if", ["eq", ["get", "token.source"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "source"],
        "x": ["get", "gutter"],
        "y": ["max", 0, ["sub", ["get", "frame.h"], 38]],
        "w": ["get", "availableWidth"],
        "h": 38,
        "chars": ["get", "token.source"],
        "style": ["get", "token.caption"],
        "color": ["get", "token.muted"],
        "align": "left",
        "alignV": "center",
        "fit": "omit"
      }
    },
    {
      "emit": {
        "kind": "line",
        "key": ["list", "zero"],
        "start": ["point", ["get", "gutter"], ["get", "zero"]],
        "end": ["point", ["sub", ["get", "frame.w"], ["get", "gutter"]], ["get", "zero"]],
        "color": ["get", "token.rule"],
        "width": 2,
        "route": "straight",
        "arrow": "none"
      }
    },
    {
      "repeat": {
        "over": ["get", "steps"],
        "as": "r"
      },
      "let": [
        ["lane", ["band", ["get", "i"], ["get", "rowCount"], ["get", "gutter"], ["get", "plotWidth"], 1]],
        ["mark", ["band", ["get", "i"], ["get", "rowCount"], ["get", "gutter"], ["get", "plotWidth"], 0.59]],
        ["a", ["linear", ["get", "r.start"], ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]],
        ["b", ["linear", ["get", "r.end"], ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]],
        ["top", ["min", ["get", "a"], ["get", "b"]]],
        ["height", ["sub", ["max", ["get", "a"], ["get", "b"]], ["get", "top"]]],
        [
          "stepFill",
          [
            "if",
            ["get", "variant.signed"],
            [
              "if",
              ["eq", ["get", "r.value"], 0],
              ["get", "neutralFill"],
              ["if", ["lt", ["get", "r.value"], 0], ["get", "token.down"], ["get", "token.up"]]
            ],
            ["get", "neutralFill"]
          ]
        ],
        ["isTotal", ["eq", ["get", "r.mode"], "total"]],
        ["prev", ["at", ["get", "steps"], ["sub", ["get", "i"], 1]]],
        [
          "mismatch",
          [
            "if",
            ["if", ["get", "isTotal"], ["lt", 0, ["get", "i"]], false],
            [
              "if",
              [
                "eq",
                ["round", ["div", ["get", "r.given"], ["get", "token.scale"]], ["get", "digits"]],
                ["round", ["div", ["get", "r.value"], ["get", "token.scale"]], ["get", "digits"]]
              ],
              false,
              ["advise", "total-mismatch", "Use the running balance for this total.", ["get", "r.id"]]
            ],
            false
          ]
        ]
      ],
      "children": [
        {
          "when": [
            "if",
            ["eq", ["get", "prev"], null],
            false,
            ["if", ["eq", ["get", "prev.after"], "reset"], false, true]
          ],
          "let": [
            ["level", ["if", ["get", "isTotal"], ["get", "b"], ["get", "a"]]],
            [
              "previous",
              ["band", ["sub", ["get", "i"], 1], ["get", "rowCount"], ["get", "gutter"], ["get", "plotWidth"], 0.59]
            ]
          ],
          "emit": {
            "kind": "line",
            "key": ["list", "bridge", ["get", "r.id"]],
            "start": ["point", ["add", ["get", "previous.start"], ["get", "previous.size"]], ["get", "level"]],
            "end": ["point", ["get", "mark.start"], ["get", "level"]],
            "color": ["get", "token.rule"],
            "width": 1,
            "route": "straight",
            "arrow": "none",
            "dash": "dot"
          }
        },
        {
          "emit": {
            "kind": "rect",
            "key": ["list", "bar", ["get", "r.id"]],
            "x": ["get", "mark.start"],
            "y": ["get", "top"],
            "w": ["get", "mark.size"],
            "h": ["max", 2, ["get", "height"]],
            "fill": [
              "if",
              ["get", "isTotal"],
              ["get", "totalFill"],
              [
                "focusColor",
                ["get", "activeFocus"],
                ["list", ["get", "r.id"]],
                ["if", ["eq", ["count", ["get", "activeFocus"]], 0], ["get", "stepFill"], ["get", "token.highlight"]],
                ["get", "stepFill"]
              ]
            ]
          }
        },
        {
          "when": ["if", ["get", "narrowValues"], false, ["get", "variant.labels"]],
          "emit": {
            "kind": "text",
            "key": ["list", "value", ["get", "r.id"]],
            "x": ["get", "lane.start"],
            "y": ["sub", ["get", "top"], 37],
            "w": ["get", "lane.size"],
            "h": 32,
            "chars": [
              "format",
              ["get", "r.value"],
              ["if", ["get", "isTotal"], ["get", "totalFormat"], ["get", "deltaFormat"]]
            ],
            "style": ["get", "token.label"],
            "color": ["get", "token.ink"],
            "align": "center",
            "alignV": "center",
            "fit": {
              "minWidth": ["get", "valueWidth"]
            }
          }
        },
        {
          "emit": {
            "kind": "text",
            "key": ["list", "category", ["get", "r.id"]],
            "x": ["get", "lane.start"],
            "y": ["get", "categoryTop"],
            "w": ["get", "lane.size"],
            "h": 56,
            "chars": ["get", "r.label"],
            "style": ["get", "token.caption"],
            "color": ["get", "token.muted"],
            "align": "center",
            "alignV": "center",
            "fit": {
              "smaller": ["get", "token.captionSmall"],
              "group": "categories",
              "thin": 4,
              "keep": ["get", "isTotal"]
            }
          }
        }
      ]
    }
  ]
}
