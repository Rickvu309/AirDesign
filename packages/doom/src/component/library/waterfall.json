{
  "version": 1,
  "name": "Waterfall",
  "collections": {
    "rows": {
      "label": "string",
      "value": "number",
      "mode": ["delta", "total"],
      "after": ["carry", "reset"]
    }
  },
  "variants": {
    "labels": [true, false]
  },
  "defaultVariant": {
    "labels": true
  },
  "defaults": {
    "scale": 1,
    "digits": 0,
    "unitHeader": "",
    "title": "",
    "ink": {
      "var": "text"
    },
    "muted": {
      "var": "text2"
    },
    "rule": "#93A6BA",
    "heading": "label",
    "label": "label",
    "caption": "caption",
    "captionSmall": 18,
    "up": {
      "var": "accent2"
    },
    "down": {
      "var": "accent5"
    },
    "total": {
      "var": "accent1"
    }
  },
  "let": [
    ["headerUnit", ["get", "token.unitHeader"]],
    [
      "header",
      [
        "if",
        ["eq", ["get", "token.title"], ""],
        ["get", "headerUnit"],
        [
          "if",
          ["eq", ["get", "headerUnit"], ""],
          ["get", "token.title"],
          ["concat", ["get", "token.title"], ", ", ["get", "headerUnit"]]
        ]
      ]
    ],
    ["gutter", ["min", 12, ["div", ["get", "frame.w"], 4]]],
    ["rowCount", ["count", ["get", "data.rows"]]],
    ["plotWidth", ["sub", ["get", "frame.w"], ["mul", 2, ["get", "gutter"]]]],
    ["categoryTop", ["max", 0, ["sub", ["get", "frame.h"], 56]]],
    ["plotBottom", ["max", 0, ["sub", ["get", "categoryTop"], 12]]],
    ["plotTop", ["min", ["div", ["get", "plotBottom"], 2], ["if", ["get", "variant.labels"], 90, 60]]],
    [
      "steps",
      [
        "scan",
        ["get", "data.rows"],
        "r",
        0,
        [
          "if",
          ["eq", ["get", "r.after"], "reset"],
          0,
          [
            "if",
            ["eq", ["get", "i"], 0],
            ["get", "r.value"],
            ["if", ["eq", ["get", "r.mode"], "total"], ["get", "acc"], ["add", ["get", "acc"], ["get", "r.value"]]]
          ]
        ],
        {
          "id": ["get", "r.id"],
          "label": ["get", "r.label"],
          "mode": ["get", "r.mode"],
          "after": ["get", "r.after"],
          "start": ["if", ["eq", ["get", "r.mode"], "total"], 0, ["get", "acc"]],
          "end": [
            "if",
            ["eq", ["get", "i"], 0],
            ["get", "r.value"],
            ["if", ["eq", ["get", "r.mode"], "total"], ["get", "acc"], ["add", ["get", "acc"], ["get", "r.value"]]]
          ],
          "value": [
            "if",
            ["eq", ["get", "i"], 0],
            ["get", "r.value"],
            ["if", ["eq", ["get", "r.mode"], "total"], ["get", "acc"], ["get", "r.value"]]
          ]
        }
      ]
    ],
    ["starts", ["map", ["get", "steps"], "r", ["get", "r.start"]]],
    ["ends", ["map", ["get", "steps"], "r", ["get", "r.end"]]],
    ["lo", ["min", 0, ["get", "starts"], ["get", "ends"]]],
    ["upper", ["max", 0, ["get", "starts"], ["get", "ends"]]],
    ["hi", ["if", ["eq", ["get", "upper"], ["get", "lo"]], 1, ["get", "upper"]]],
    ["zero", ["linear", 0, ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]],
    [
      "deltaFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": ["get", "token.digits"],
        "prefix": "",
        "suffix": "",
        "sign": "always"
      }
    ],
    [
      "totalFormat",
      {
        "scale": ["get", "token.scale"],
        "digits": ["get", "token.digits"],
        "prefix": "",
        "suffix": "",
        "sign": "negative"
      }
    ]
  ],
  "parts": [
    {
      "when": ["if", ["eq", ["get", "header"], ""], false, true],
      "emit": {
        "kind": "text",
        "key": ["list", "unit"],
        "x": ["get", "gutter"],
        "y": 0,
        "w": ["get", "plotWidth"],
        "h": 42,
        "chars": ["get", "header"],
        "style": ["get", "token.heading"],
        "color": ["get", "token.ink"],
        "align": "left",
        "alignV": "center",
        "fit": "omit"
      }
    },
    {
      "emit": {
        "kind": "line",
        "key": ["list", "zero"],
        "start": ["point", ["get", "gutter"], ["get", "zero"]],
        "end": ["point", ["sub", ["get", "frame.w"], ["get", "gutter"]], ["get", "zero"]],
        "color": ["get", "token.rule"],
        "width": 2,
        "route": "straight",
        "arrow": "none"
      }
    },
    {
      "repeat": {
        "over": ["get", "steps"],
        "as": "r"
      },
      "let": [
        ["lane", ["band", ["get", "i"], ["get", "rowCount"], ["get", "gutter"], ["get", "plotWidth"], 1]],
        ["mark", ["band", ["get", "i"], ["get", "rowCount"], ["get", "gutter"], ["get", "plotWidth"], 0.59]],
        ["a", ["linear", ["get", "r.start"], ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]],
        ["b", ["linear", ["get", "r.end"], ["get", "lo"], ["get", "hi"], ["get", "plotBottom"], ["get", "plotTop"]]],
        ["top", ["min", ["get", "a"], ["get", "b"]]],
        ["height", ["sub", ["max", ["get", "a"], ["get", "b"]], ["get", "top"]]],
        ["isTotal", ["eq", ["get", "r.mode"], "total"]],
        ["prev", ["at", ["get", "steps"], ["sub", ["get", "i"], 1]]]
      ],
      "children": [
        {
          "when": [
            "if",
            ["eq", ["get", "prev"], null],
            false,
            ["if", ["eq", ["get", "prev.after"], "reset"], false, true]
          ],
          "let": [
            ["level", ["if", ["get", "isTotal"], ["get", "b"], ["get", "a"]]],
            [
              "previous",
              ["band", ["sub", ["get", "i"], 1], ["get", "rowCount"], ["get", "gutter"], ["get", "plotWidth"], 0.59]
            ]
          ],
          "emit": {
            "kind": "line",
            "key": ["list", "bridge", ["get", "r.id"]],
            "start": ["point", ["add", ["get", "previous.start"], ["get", "previous.size"]], ["get", "level"]],
            "end": ["point", ["get", "mark.start"], ["get", "level"]],
            "color": ["get", "token.rule"],
            "width": 2,
            "route": "straight",
            "arrow": "none"
          }
        },
        {
          "emit": {
            "kind": "rect",
            "key": ["list", "bar", ["get", "r.id"]],
            "x": ["get", "mark.start"],
            "y": ["get", "top"],
            "w": ["get", "mark.size"],
            "h": ["max", 2, ["get", "height"]],
            "fill": [
              "if",
              ["get", "isTotal"],
              ["get", "token.total"],
              ["if", ["lt", ["get", "r.value"], 0], ["get", "token.down"], ["get", "token.up"]]
            ]
          }
        },
        {
          "when": ["get", "variant.labels"],
          "emit": {
            "kind": "text",
            "key": ["list", "value", ["get", "r.id"]],
            "x": ["get", "lane.start"],
            "y": ["sub", ["get", "top"], 37],
            "w": ["get", "lane.size"],
            "h": 32,
            "chars": [
              "format",
              ["get", "r.value"],
              ["if", ["get", "isTotal"], ["get", "totalFormat"], ["get", "deltaFormat"]]
            ],
            "style": ["get", "token.label"],
            "color": ["get", "token.ink"],
            "align": "center",
            "alignV": "center",
            "fit": {
              "minWidth": 24
            }
          }
        },
        {
          "emit": {
            "kind": "text",
            "key": ["list", "category", ["get", "r.id"]],
            "x": ["get", "lane.start"],
            "y": ["get", "categoryTop"],
            "w": ["get", "lane.size"],
            "h": 56,
            "chars": ["get", "r.label"],
            "style": ["get", "token.caption"],
            "color": ["get", "token.muted"],
            "align": "center",
            "alignV": "center",
            "fit": {
              "smaller": ["get", "token.captionSmall"],
              "group": "categories",
              "thin": 4
            }
          }
        }
      ]
    }
  ]
}
