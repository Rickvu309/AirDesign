{
  "version": 1,
  "name": "Process",
  "collections": {
    "steps": {
      "label": "string",
      "description": "string?",
      "note": "string?"
    }
  },
  "variants": {
    "direction": ["row", "column"]
  },
  "defaultVariant": {
    "direction": "row"
  },
  "defaults": {
    "ink": {
      "var": "text"
    },
    "card": {
      "var": "background"
    },
    "edge": {
      "var": "text2",
      "tint": 0.7
    },
    "connector": {
      "var": "text2"
    },
    "label": "heading",
    "labelSmall": 20,
    "gap": 64,
    "radius": 8,
    "lineWidth": 2,
    "number": {
      "var": "accent1"
    },
    "description": {
      "var": "text2"
    },
    "columnLabel": "label",
    "columnGap": 16,
    "cardHeight": 240,
    "rowLabelSmall": 26,
    "focus": ""
  },
  "let": [
    ["row", ["eq", ["get", "variant.direction"], "row"]],
    ["count", ["max", 1, ["count", ["get", "data.steps"]]]],
    [
      "gap",
      [
        "if",
        ["get", "row"],
        ["min", ["get", "token.gap"], ["div", ["get", "frame.w"], ["mul", ["get", "count"], 5]]],
        ["get", "token.columnGap"]
      ]
    ],
    ["gaps", ["mul", ["get", "gap"], ["sub", ["get", "count"], 1]]],
    [
      "cardW",
      [
        "if",
        ["get", "row"],
        ["min", 360, ["div", ["max", 0, ["sub", ["get", "frame.w"], ["get", "gaps"]]], ["get", "count"]]],
        ["min", 560, ["get", "frame.w"]]
      ]
    ],
    [
      "cardH",
      [
        "if",
        ["get", "row"],
        ["min", ["get", "token.cardHeight"], ["get", "frame.h"]],
        ["min", 132, ["div", ["max", 0, ["sub", ["get", "frame.h"], ["get", "gaps"]]], ["get", "count"]]]
      ]
    ],
    ["stepX", ["if", ["get", "row"], ["add", ["get", "cardW"], ["get", "gap"]], 0]],
    ["stepY", ["if", ["get", "row"], 0, ["add", ["get", "cardH"], ["get", "gap"]]]],
    [
      "left",
      [
        "div",
        ["sub", ["get", "frame.w"], ["add", ["get", "cardW"], ["mul", ["get", "stepX"], ["sub", ["get", "count"], 1]]]],
        2
      ]
    ],
    [
      "top",
      [
        "div",
        ["sub", ["get", "frame.h"], ["add", ["get", "cardH"], ["mul", ["get", "stepY"], ["sub", ["get", "count"], 1]]]],
        2
      ]
    ],
    ["first", ["at", ["get", "data.steps"], 0]],
    [
      "focus",
      [
        "if",
        [
          "lt",
          0,
          ["count", ["filter", ["get", "data.steps"], "step", ["eq", ["get", "step.id"], ["get", "token.focus"]]]]
        ],
        ["get", "token.focus"],
        ["if", ["lt", 0, ["count", ["get", "data.steps"]]], ["get", "first.id"], ""]
      ]
    ]
  ],
  "layout": {
    "mode": ["get", "variant.direction"],
    "gap": ["get", "gap"],
    "padding": {
      "t": 0,
      "r": 0,
      "b": 0,
      "l": 0
    },
    "align": "center-center"
  },
  "parts": [
    {
      "repeat": {
        "over": ["get", "data.steps"],
        "as": "s"
      },
      "let": [
        ["focused", ["eq", ["get", "s.id"], ["get", "focus"]]],
        [
          "stepNumber",
          [
            "format",
            ["add", ["get", "i"], 1],
            {
              "scale": 1,
              "digits": 0,
              "prefix": "",
              "suffix": "",
              "sign": "negative"
            }
          ]
        ],
        [
          "number",
          {
            "chars": ["if", ["lt", ["get", "i"], 9], ["concat", "0", ["get", "stepNumber"]], ["get", "stepNumber"]],
            "color": ["if", ["get", "focused"], ["get", "token.number"], ["get", "token.description"]],
            "scale": 0.8,
            "bold": true,
            "wrap": "none"
          }
        ],
        [
          "title",
          {
            "chars": ["get", "s.label"],
            "color": ["get", "token.ink"],
            "spaceBefore": ["if", ["get", "row"], 16, 3]
          }
        ],
        [
          "description",
          {
            "chars": ["get", "s.description"],
            "color": ["get", "token.description"],
            "bold": false,
            "scale": ["if", ["get", "row"], 0.77, 0.72],
            "maxLines": ["if", ["get", "row"], 3, 1],
            "spaceBefore": ["if", ["get", "row"], 6, 2]
          }
        ],
        [
          "duration",
          {
            "chars": ["get", "s.note"],
            "color": ["get", "token.description"],
            "scale": 0.8,
            "bold": false,
            "wrap": "none",
            "spaceBefore": 8
          }
        ],
        ["x", ["add", ["get", "left"], ["mul", ["get", "i"], ["get", "stepX"]]]],
        ["y", ["add", ["get", "top"], ["mul", ["get", "i"], ["get", "stepY"]]]],
        ["note", ["get", "s.note"]],
        [
          "noteW",
          [
            "if",
            ["get", "row"],
            0,
            [
              "if",
              ["eq", ["get", "note"], ""],
              0,
              ["textWidth", ["get", "note"], ["get", "token.columnLabel"], ["get", "token.labelSmall"]]
            ]
          ]
        ]
      ],
      "children": [
        {
          "when": ["get", "row"],
          "emit": {
            "kind": "text",
            "key": ["list", "step", ["get", "s.id"]],
            "x": ["get", "x"],
            "y": ["get", "y"],
            "w": ["get", "cardW"],
            "h": ["get", "cardH"],
            "chars": [
              "filter",
              ["list", ["get", "number"], ["get", "title"], ["get", "description"], ["get", "duration"]],
              "paragraph",
              ["if", ["lt", ["get", "i"], 2], true, ["if", ["eq", ["get", "paragraph.chars"], ""], false, true]]
            ],
            "style": ["get", "token.label"],
            "color": ["get", "token.ink"],
            "align": "left",
            "alignV": "top",
            "fill": ["get", "token.card"],
            "overflow": "ellipsis",
            "stroke": {
              "color": ["if", ["get", "focused"], ["get", "token.number"], ["get", "token.edge"]],
              "width": 2
            },
            "radius": ["get", "token.radius"],
            "padding": {
              "t": 24,
              "r": 16,
              "b": 24,
              "l": 16
            },
            "fit": {
              "smaller": ["get", "token.rowLabelSmall"],
              "group": "steps"
            }
          }
        },
        {
          "when": ["eq", ["get", "row"], false],
          "emit": {
            "kind": "text",
            "key": ["list", "step", ["get", "s.id"]],
            "x": ["get", "x"],
            "y": ["get", "y"],
            "w": ["get", "cardW"],
            "h": ["get", "cardH"],
            "chars": [
              "filter",
              [
                "list",
                {
                  "chars": [
                    "if",
                    ["lt", ["get", "i"], 9],
                    ["concat", "0", ["get", "stepNumber"]],
                    ["get", "stepNumber"]
                  ],
                  "color": ["if", ["get", "focused"], ["get", "token.number"], ["get", "token.description"]],
                  "scale": 0.8,
                  "bold": true,
                  "wrap": "none",
                  "lineHeight": 1.2
                },
                ["get", "title"],
                ["get", "description"]
              ],
              "paragraph",
              ["if", ["lt", ["get", "i"], 2], true, ["eq", ["eq", ["get", "paragraph.chars"], ""], false]]
            ],
            "style": ["get", "token.columnLabel"],
            "color": ["get", "token.ink"],
            "align": "left",
            "alignV": "top",
            "fill": ["get", "token.card"],
            "overflow": "ellipsis",
            "stroke": {
              "color": ["if", ["get", "focused"], ["get", "token.number"], ["get", "token.edge"]],
              "width": 2
            },
            "radius": ["get", "token.radius"],
            "padding": {
              "t": 7,
              "r": ["add", 20, ["if", ["eq", ["get", "note"], ""], 0, ["add", ["get", "noteW"], 16]]],
              "b": 7,
              "l": 20
            },
            "size": ["get", "token.labelSmall"]
          }
        },
        {
          "when": ["if", ["get", "row"], false, ["eq", ["eq", ["get", "note"], ""], false]],
          "emit": {
            "kind": "text",
            "key": ["list", "duration", ["get", "s.id"]],
            "x": ["add", ["get", "x"], ["max", 20, ["sub", ["get", "cardW"], ["add", 20, ["get", "noteW"]]]]],
            "y": ["add", ["get", "y"], ["add", 10, ["mul", ["get", "token.labelSmall"], 0.96]]],
            "w": ["min", ["max", 0, ["sub", ["get", "cardW"], 40]], ["get", "noteW"]],
            "h": ["max", 0, ["sub", ["get", "cardH"], ["add", 17, ["mul", ["get", "token.labelSmall"], 0.96]]]],
            "chars": [
              "list",
              {
                "chars": ["get", "note"],
                "bold": false,
                "wrap": "none"
              }
            ],
            "style": ["get", "token.columnLabel"],
            "size": ["get", "token.labelSmall"],
            "color": ["get", "token.description"],
            "align": "right",
            "alignV": "top",
            "absolute": true,
            "overflow": "ellipsis"
          }
        }
      ]
    },
    {
      "repeat": {
        "over": ["get", "data.steps"],
        "as": "s"
      },
      "let": [["following", ["at", ["get", "data.steps"], ["add", ["get", "i"], 1]]]],
      "when": ["lt", ["add", ["get", "i"], 1], ["count", ["get", "data.steps"]]],
      "emit": {
        "kind": "line",
        "key": ["list", "connector", ["get", "s.id"]],
        "start": ["site", ["list", "step", ["get", "s.id"]], ["if", ["get", "row"], "r", "b"]],
        "end": ["site", ["list", "step", ["get", "following.id"]], ["if", ["get", "row"], "l", "t"]],
        "color": ["get", "token.connector"],
        "width": ["get", "token.lineWidth"],
        "route": "straight",
        "arrow": "triangle"
      }
    },
    {
      "let": [
        [
          "manySteps",
          [
            "if",
            ["lt", 5, ["get", "count"]],
            ["advise", "many-steps", "Split the steps across two process diagrams."],
            false
          ]
        ]
      ],
      "children": []
    }
  ]
}
