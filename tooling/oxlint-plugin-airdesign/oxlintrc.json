{
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "jsPlugins": [
    {
      "name": "airdesign",
      "specifier": "./index.js"
    }
  ],
  "rules": {
    "airdesign/no-bare-test": "error",
    "airdesign/no-blind-wait": [
      "error",
      {
        "kept": {
          "tests/browser/design-states.spec.ts": 1,
          "tests/browser/drag-feel.ts": 1,
          "tests/browser/export-dialog.spec.ts": 1,
          "tests/browser/grid-reorder.spec.ts": 4,
          "tests/browser/slide-findings.spec.ts": 1,
          "tests/browser/text-fit.spec.ts": 2,
          "tests/browser/theme.spec.ts": 1,
          "tests/browser/typing-renders.spec.ts": 1
        }
      }
    ],
    "airdesign/no-byte-counter": "error",
    "airdesign/no-comments": "error",
    "airdesign/no-element-id-cast": "warn",
    "airdesign/no-env-outside-entry": "error",
    "airdesign/no-field-edge": "error",
    "airdesign/no-hidden-input": "warn",
    "airdesign/no-http-outside-server": "error",
    "airdesign/no-limit-in-copy": "error",
    "airdesign/no-raw": "error",
    "airdesign/no-route-literal": "error",
    "airdesign/no-run-literal": "error",
    "airdesign/no-stamp-literal": "error",
    "airdesign/no-xml-search": "error"
  }
}
