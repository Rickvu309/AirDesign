{
  "name": "ts-packwerk",
  "version": "0.1.0",
  "private": true,
  "description": "Packs for TypeScript: dependencies, privacy, layers, named interfaces and table ownership, checked in under a second. After Shopify's Packwerk.",
  "keywords": [
    "packwerk",
    "modular monolith",
    "architecture",
    "boundaries",
    "monorepo",
    "typescript",
    "oxc",
    "lint"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ts-packwerk": "./bin/ts-packwerk.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lint": {
      "types": "./dist/lint.d.ts",
      "import": "./dist/lint.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.*",
    "!dist/fixture.*",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE",
    "README.md",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "prepack": "rm -rf dist && tsc -p tsconfig.release.json"
  },
  "dependencies": {
    "oxc-parser": "^0.157.0",
    "oxc-resolver": "^11.24.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "catalog:"
  }
}
