{
  "name": "airdesign",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "probe:compat": "node --experimental-strip-types scripts/probe-compat.ts",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:access": "node scripts/verify-access.mjs",
    "verify:pr-01": "node scripts/verify-pr-01.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node --experimental-strip-types scripts/lint-sources.ts && oxlint .",
    "build:deck": "node scripts/build-deck.mjs",
    "probe:deck": "node scripts/probe-deck.mjs",
    "verify:deck": "node scripts/verify-deck.mjs",
    "verify:render": "node scripts/verify-render.mjs",
    "verify:pr-02": "npm run verify:deck && npm run verify:render",
    "verify:operations": "node scripts/verify-operations.mjs",
    "verify:pptx": "node scripts/verify-pptx.mjs",
    "verify:pr-03": "npm run verify:operations && npm run verify:pptx",
    "worker:once": "node apps/worker/src/main.ts",
    "pptx": "node packages/pptx/src/cli.ts",
    "operations": "node apps/server/src/operations/cli.ts",
    "verify:change-log": "node scripts/verify-change-log.mjs",
    "verify:history": "npm run verify:change-log",
    "verify:pr-04": "npm run verify:change-log && npm run verify:sync",
    "verify:sync": "node scripts/verify-sync.mjs",
    "verify:studio": "node scripts/verify-studio.mjs",
    "build:export-renderer": "vite build --ssr apps/worker/src/export/render.tsx --outDir apps/worker/dist",
    "verify:import-export": "node scripts/verify-import-export.mjs",
    "verify:pr-05": "npm run verify:studio && npm run verify:import-export",
    "verify:brand": "node scripts/verify-brand.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:pr-06": "npm run verify:brand && npm run verify:assets"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "happy-dom": "20.0.11",
    "oxlint": "1.91.0",
    "pdfjs-dist": "6.5.438",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
