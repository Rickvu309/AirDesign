{
  "name": "airdesign",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "new:package": "node scripts/new-package.mjs",
    "lint": "pnpm -r --if-present run lint && node tooling/oxlint-plugin-airdesign/lint-tree.js",
    "typecheck": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:pptx": "bash scripts/pptx-tools.sh node scripts/pptx-check.mjs",
    "check:mutation": "node scripts/check-mutation.mjs",
    "test": "pnpm test:unit && pnpm test:tooling",
    "test:unit": "vitest run",
    "test:tooling": "node tooling/oxlint-plugin-airdesign/run-tests.js && node scripts/bug-rule.test.mjs && node scripts/metrics.test.mjs && node scripts/ratchet.test.mjs && node scripts/judge-proof.test.mjs && node scripts/ci-failure-report.test.mjs && node scripts/check-regression.test.mjs && node scripts/check.test.mjs && node scripts/machine-lock.test.mjs && node scripts/check-specs.test.mjs && node scripts/browser-export.test.mjs",
    "test:browser": "playwright test",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "fast-check": "4.10.2",
    "jsdom": "^31.0.0",
    "oxc-parser": "^0.157.0",
    "oxfmt": "0.78.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "typescript": "catalog:",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  }
}
