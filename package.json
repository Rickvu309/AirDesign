{
  "name": "@airdesign/ui",
  "version": "0.1.0",
  "description": "AirDesign UI kit: accessible React components, icons and design tokens",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots/index.d.ts",
      "default": "./dist/snapshots/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./kit.css": "./dist/styles/kit.css",
    "./workspace.css": "./dist/styles/workspace.css",
    "./base.css": "./dist/styles/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "catalog": "npm run build && node scripts/build-catalog.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19",
    "jsdom": "^30.1.3",
    "react": "^19",
    "react-dom": "^19.3.1",
    "typescript": "^5"
  },
  "license": "UNLICENSED"
}
