{
  "name": "airdesign",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "check": "node scripts/check.mjs",
    "land": "node scripts/land.mjs",
    "pr-body": "node scripts/pr-body-update.mjs",
    "gate": "node scripts/gate.mjs",
    "rules": "node scripts/rules.mjs",
    "sweep": "node scripts/sweep.mjs",
    "dead-code": "node scripts/dead-code.mjs",
    "detach": "node scripts/detach.mjs",
    "new:package": "node scripts/new-package.mjs",
    "lint": "pnpm -r --if-present run lint && node tooling/oxlint-plugin-airdesign/lint-tree.js",
    "typecheck": "node scripts/typecheck.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs && ts-packwerk check && ts-packwerk docs --out docs/packs.md --check && node scripts/todo-ceiling.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:pdf": "node scripts/pdf-check.mjs",
    "check:mutation": "node scripts/check-mutation.mjs",
    "test": "pnpm test:unit && pnpm test:tooling",
    "test:unit": "vitest run",
    "test:tooling": "node scripts/tooling-tests.mjs",
    "timings": "node scripts/timings.mjs",
    "prove": "node .agents/skills/verify-airdesign/bin/verify-airdesign.mjs prove",
    "test:browser": "if [ \"${AIRDESIGN_WEB_BUILT:-}\" != 1 ]; then pnpm build:browser; fi && playwright test",
    "test:production": "playwright test -c playwright.production.config.ts",
    "test:journeys": "pnpm --workspace-concurrency=1 --filter @airdesign/api --filter web build && playwright test -c playwright.journeys.config.mts",
    "build:browser": "pnpm --workspace-concurrency=1 --filter @airdesign/api --filter web build",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@echogarden/icu-segmentation-wasm": "0.4.0",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.2",
    "bidi-js": "1.1.0",
    "fast-check": "4.10.2",
    "harfbuzzjs": "1.6.4",
    "jsdom": "^31.0.0",
    "oxc-parser": "^0.157.0",
    "oxfmt": "0.78.0",
    "oxlint": "^1.90.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.32",
    "railway": "3.16.0",
    "ts-packwerk": "0.1.5",
    "typescript": "catalog:",
    "typescript-api": "npm:typescript@6.0.3",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  }
}
