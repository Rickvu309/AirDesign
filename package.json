{
  "name": "airdesign",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "new:package": "node scripts/new-package.mjs",
    "lint": "pnpm -r --if-present run lint && node tooling/oxlint-plugin-airdesign/lint-tree.js",
    "typecheck": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "test": "vitest run && node tooling/oxlint-plugin-airdesign/run-tests.js && node scripts/bug-rule.test.mjs && node scripts/check-specs.test.mjs",
    "test:browser": "playwright test",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@playwright/test": "1.65.0",
    "fast-check": "4.10.2",
    "oxc-parser": "^0.157.0",
    "oxfmt": "0.78.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "typescript": "catalog:",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  }
}
